# === LLM (via LiteLLM) ===
# Format : "<provider>/<model>". Voir https://docs.litellm.ai/docs/providers
LLM_MODEL=anthropic/claude-sonnet-5-5
# Phase 13 — un modèle par tâche (voir docs/LLM_COSTS.md). Vide = LLM_MODEL,
# ou LLM_CHEAP_MODEL pour PREFILTER / EXTRACT.
LLM_CHEAP_MODEL=anthropic/claude-haiku-5-5
LLM_MODEL_CLASSIFY=anthropic/claude-haiku-5-5
LLM_MODEL_PREFILTER=
LLM_MODEL_EXTRACT=
LLM_MODEL_WRITE=
LLM_MODEL_AGENT=
# Filtre gratuit par mots-clés avant toute IA (actif dès que tu as des mots-clés).
KEYWORD_PREFILTER_ENABLED=true
LLM_FALLBACK_MODEL=
# Seconds to sleep between consecutive classify() calls. Set to ~7 on
# Anthropic Tier 1 (30k TPM) to avoid rate-limit retries. 0 = no limit.
LLM_RATE_LIMIT_SECONDS=0

# Clés API — uniquement celles correspondant aux modèles utilisés
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434  # si modèle local

# === Sources ===
NEWSAPI_KEY=
PAPPERS_API_KEY=
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# === Notification ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO_EMAIL=
DIGEST_FROM_EMAIL=
# Alternative à SMTP :
# RESEND_API_KEY=

# === Runtime ===
DIGEST_SEND_HOUR=7
DIGEST_TIMEZONE=Europe/Paris
# If set, the digest renders "Marquer comme contacte" links pointing at this
# base URL (e.g. https://tracker.yourdomain.com).
DASHBOARD_BASE_URL=
LOG_LEVEL=INFO

# === Database ===
# Dev: leave DATABASE_URL empty, falls back to the SQLite file at DB_PATH.
# Prod: set DATABASE_URL and ignore DB_PATH.
DB_PATH=data/signals.db
# DATABASE_URL=postgresql+psycopg://signaltracker:changeme@db:5432/signaltracker

# === Dashboard auth (prod only) ===
# When DASHBOARD_AUTH_USER is set, the dashboard requires HTTP Basic Auth on
# every route except /healthz. Leave empty in dev to disable auth.
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASSWORD=

# === Postgres (only used by docker-compose to provision the db service) ===
POSTGRES_USER=signaltracker
POSTGRES_PASSWORD=changeme-please
POSTGRES_DB=signaltracker

# --- Phase 12 : alertes offres + suivi des candidatures -------------------
# Chaque jour, le scheduler scrape les pages carrières des entreprises de ta
# watchlist + de tes signaux récents, puis donne un score de match IA aux
# nouvelles offres (1 appel LLM léger par offre, plafonné).
# Mets JOBS_AUTO_SCORE_LIMIT=0 pour ne scorer qu'à la main (bouton sur /jobs).
JOBS_DAILY_REFRESH_ENABLED=true
JOBS_AUTO_SCORE_LIMIT=10
JOBS_AUTO_SCORE_MIN_HEURISTIC=10
# Score IA minimum pour qu'une offre apparaisse dans le digest du matin.
JOB_ALERT_THRESHOLD=60

# Relecture du CV adapté par un 2e agent IA (modèle économique, ~0,01 $) :
# retire tout ce que ton CV ne prouve pas. false = uniquement quand tu
# cliques sur « Relecture anti-invention » (recommandé pour maîtriser le coût).
TAILOR_REVIEW_ENABLED=false

# JobSpy (optionnel) : cherche aussi sur Indeed / Google Jobs / LinkedIn par
# mots-clés et pays. Il faut construire l'image avec INSTALL_JOBSPY=1 :
#   INSTALL_JOBSPY=1 docker compose -f docker-compose.lite.yml up -d --build
# Accès non officiels : peuvent casser sans prévenir ; LinkedIn bloque vite.
# Ajoute ~150 Mo de RAM (pandas) : à éviter sur e2-micro si la mémoire est juste.
JOBSPY_ENABLED=false
JOBSPY_SITES=indeed,google
JOBSPY_RESULTS_PER_SEARCH=30
JOBSPY_HOURS_OLD=168
# Jours après "Postulée" avant de proposer une relance.
APPLICATION_FOLLOWUP_DAYS=7

# --- Newsletter hebdomadaire ----------------------------------------------
# Déclencheur propre (indépendant du digest) : ce jour-là à cette heure
# (fuseau DIGEST_TIMEZONE). 0 = lundi ... 6 = dimanche, -1 = jamais.
# Envoyée à chaque utilisateur validé et abonné, avec DIGEST_FROM_EMAIL
# comme expéditeur. DASHBOARD_BASE_URL sert aux liens vers l'outil,
# SESSION_SECRET_KEY aux liens de désabonnement : renseigne les deux.
NEWSLETTER_WEEKDAY=6
NEWSLETTER_HOUR=9
NEWSLETTER_MINUTE=0
NEWSLETTER_PERIOD_DAYS=7
# Top N de la semaine dans chaque section.
NEWSLETTER_MAX_SIGNALS=10
NEWSLETTER_MAX_JOBS=10
# Score IA minimum d'une offre, et exclusion des offres possiblement fantômes.
NEWSLETTER_JOB_MIN_SCORE=50
NEWSLETTER_HIDE_GHOST=true
SESSION_SECRET_KEY=

# LinkedIn (optionnel, DÉSACTIVÉ par défaut) via agent-reach / mcporter.
# Session LinkedIn authentifiée = contraire aux CGU LinkedIn : risque de
# restriction du compte. Préférer un compte secondaire, garder des limites basses.
# Voir docs/LINKEDIN.md.
LINKEDIN_ENABLED=false
LINKEDIN_MCPORTER_BIN=mcporter
LINKEDIN_MIN_INTERVAL_SECONDS=20
LINKEDIN_DAILY_LIMIT=30
# Actualités LinkedIn : activer aussi la section `linkedin` de config/sources.yaml.
