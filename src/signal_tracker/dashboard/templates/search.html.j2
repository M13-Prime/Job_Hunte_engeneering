{% extends "base.html.j2" %}
{% block title %}Signal Tracker — Lancer une recherche{% endblock %}
{% block nav_search %}active{% endblock %}

{% block extra_css %}
  /* ---------------- Hero ---------------- */
  .hero {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 56px; align-items: center;
    padding: 24px 0 8px;
  }
  @media (max-width: 980px) { .hero { grid-template-columns: 1fr; gap: 36px; padding-top: 8px; } }

  .hero-text .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12.5px; font-weight: 600; color: var(--green-deep);
    background: var(--green-soft); border: 1px solid rgba(52,199,89,0.22);
    padding: 5px 12px; border-radius: var(--r-full);
    letter-spacing: 0.02em; margin-bottom: 22px;
  }
  .hero-text .eyebrow .ping {
    width: 7px; height: 7px; border-radius: 50%; background: var(--green);
    box-shadow: 0 0 0 0 rgba(52,199,89,0.6); animation: pingdot 2s ease-out infinite;
  }
  @keyframes pingdot {
    0% { box-shadow: 0 0 0 0 rgba(52,199,89,0.6); }
    70% { box-shadow: 0 0 0 8px rgba(52,199,89,0); }
    100% { box-shadow: 0 0 0 0 rgba(52,199,89,0); }
  }

  .hero-text h1 {
    font-size: var(--display); font-weight: 700; color: var(--text);
    letter-spacing: -0.045em; line-height: 1.02; margin: 0 0 18px;
  }
  .hero-text h1 .grad {
    background: linear-gradient(120deg, var(--green) 0%, #1aa3b0 50%, var(--blue) 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-text p.lead {
    color: var(--text-3); font-size: 19px; line-height: 1.5; max-width: 520px;
    letter-spacing: -0.012em; margin: 0 0 28px;
  }
  .hero-cta-row {
    display: inline-flex; align-items: center; gap: 14px; flex-wrap: wrap;
    margin-bottom: 26px;
  }
  .hero-stats {
    display: inline-flex; gap: 28px; align-items: center; flex-wrap: wrap;
    padding-top: 22px; border-top: 1px solid var(--hairline-2);
  }
  .hero-stats .stat .n {
    display: block; font-size: 28px; font-weight: 700; color: var(--text);
    letter-spacing: -0.025em; line-height: 1; font-variant-numeric: tabular-nums;
  }
  .hero-stats .stat .l { font-size: 12.5px; color: var(--text-3); margin-top: 4px; letter-spacing: 0.01em; }

  /* ---------------- Hero preview card (floating mock) ---------------- */
  .hero-preview { position: relative; min-height: 360px; }
  .hero-preview .glow {
    position: absolute; inset: -40px;
    background: radial-gradient(50% 50% at 60% 40%, rgba(52,199,89,0.18), rgba(52,199,89,0) 70%),
                radial-gradient(40% 40% at 25% 70%, rgba(0,113,227,0.13), rgba(0,113,227,0) 70%);
    filter: blur(4px); pointer-events: none; z-index: 0;
  }
  .preview-card {
    position: relative; z-index: 1; background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-xl);
    box-shadow: 0 30px 80px rgba(11,40,80,0.14), 0 6px 20px rgba(11,40,80,0.06);
    padding: 22px; max-width: 430px; margin: 0 0 0 auto;
    transform: rotate(-1.5deg);
    animation: float 7s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: rotate(-1.5deg) translateY(0); }
    50%      { transform: rotate(-1deg)   translateY(-8px); }
  }
  .preview-card .pv-head {
    display: flex; align-items: center; gap: 10px; margin-bottom: 14px;
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--text-3);
  }
  .preview-card .pv-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px rgba(52,199,89,0.18); }
  .preview-card .pv-row {
    display: flex; gap: 14px; padding: 14px 0;
    border-top: 1px solid var(--hairline-2);
  }
  .preview-card .pv-row:first-of-type { border-top: 0; padding-top: 0; }
  .preview-card .pv-score {
    flex-shrink: 0; width: 52px; height: 38px; border-radius: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 15px; font-variant-numeric: tabular-nums; letter-spacing: -0.02em;
  }
  .preview-card .pv-score.hot { background: var(--red-soft); color: var(--red); }
  .preview-card .pv-score.investigate { background: var(--blue-soft); color: var(--blue); }
  .preview-card .pv-score.watch { background: var(--amber-soft); color: var(--amber); }
  .preview-card .pv-meta { flex: 1; min-width: 0; }
  .preview-card .pv-meta .name {
    font-weight: 600; font-size: 14.5px; color: var(--text);
    display: inline-flex; align-items: center; gap: 8px;
  }
  .preview-card .pv-meta .name .new {
    font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: var(--r-full);
    background: var(--green); color: white;
  }
  .preview-card .pv-meta .sum { color: var(--text-3); font-size: 13px; margin-top: 3px; line-height: 1.45; }

  /* ---------------- "How it works" strip ---------------- */
  .how {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
    margin: 56px 0 8px;
  }
  @media (max-width: 820px) { .how { grid-template-columns: 1fr; } }
  .how .step {
    background: var(--surface); border: 1px solid var(--hairline-2);
    border-radius: var(--r-lg); padding: 22px 22px 20px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.025), 0 8px 24px rgba(11,40,80,0.04);
    transition: transform 280ms cubic-bezier(0.22,1,0.36,1), box-shadow 280ms ease;
  }
  .how .step:hover { transform: translateY(-3px); box-shadow: 0 1px 2px rgba(0,0,0,0.03), 0 18px 38px rgba(11,40,80,0.08); }
  .how .step .ico {
    width: 38px; height: 38px; border-radius: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    margin-bottom: 14px;
  }
  .how .step .ico svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .how .step.s1 .ico { background: var(--green-soft); color: var(--green-deep); }
  .how .step.s2 .ico { background: var(--blue-soft); color: var(--blue); }
  .how .step.s3 .ico { background: var(--purple-soft); color: var(--purple); }
  .how .step .num {
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--text-4); margin-bottom: 6px;
  }
  .how .step h3 { font-size: 17px; margin: 0 0 4px; color: var(--text); font-weight: 600; }
  .how .step p { font-size: 13.5px; color: var(--text-3); margin: 0; line-height: 1.5; }

  /* ---------------- "Why / Description" panel ---------------- */
  .why {
    margin-top: 64px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-xl);
    padding: 48px 48px 40px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.025), 0 8px 24px rgba(11,40,80,0.04);
    position: relative; overflow: hidden;
  }
  .why::before {
    content: ""; position: absolute; top: -120px; right: -120px;
    width: 360px; height: 360px; border-radius: 50%;
    background: radial-gradient(circle, rgba(52,199,89,0.13), rgba(52,199,89,0) 70%);
    pointer-events: none;
  }
  .why .why-head { position: relative; z-index: 1; max-width: 720px; margin-bottom: 32px; }
  .why .why-eyebrow {
    font-size: 12.5px; font-weight: 600; color: var(--green-deep);
    text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 12px;
  }
  .why .why-head h2 {
    font-size: 32px; font-weight: 700; color: var(--text);
    letter-spacing: -0.028em; line-height: 1.15; margin: 0 0 14px;
  }
  .why .why-head p { font-size: 17px; color: var(--text-2); margin: 0; line-height: 1.55; max-width: 640px; }
  .why-grid {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px 36px;
  }
  @media (max-width: 760px) {
    .why { padding: 32px 24px; }
    .why .why-head h2 { font-size: 26px; }
    .why-grid { grid-template-columns: 1fr; gap: 22px; }
  }
  .why-item { display: flex; gap: 14px; }
  .why-item .ico {
    flex-shrink: 0; width: 36px; height: 36px; border-radius: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--green-soft); color: var(--green-deep);
  }
  .why-item.b .ico { background: var(--blue-soft); color: var(--blue); }
  .why-item.p .ico { background: var(--purple-soft); color: var(--purple); }
  .why-item.a .ico { background: var(--amber-soft); color: var(--amber); }
  .why-item .ico svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .why-item h4 { font-size: 15px; font-weight: 600; color: var(--text); margin: 2px 0 4px; letter-spacing: -0.012em; }
  .why-item p { font-size: 13.5px; color: var(--text-3); margin: 0; line-height: 1.55; }

  /* ---------------- Workspace grid ---------------- */
  .grid {
    display: grid; grid-template-columns: minmax(0,1.5fr) 380px;
    gap: 28px; margin-top: 44px; align-items: start;
  }
  @media (max-width: 980px) { .grid { grid-template-columns: 1fr; } }

  /* ---------------- Keyword editor ---------------- */
  .kw-group { margin-bottom: 24px; }
  .kw-group:last-of-type { margin-bottom: 0; }
  .kw-label {
    font-size: 13px; font-weight: 600; color: var(--text);
    margin-bottom: 8px; display: flex; align-items: baseline; gap: 10px;
  }
  .kw-label .hint { color: var(--text-4); font-size: 12px; font-weight: 400; }

  /* ---------------- CV-suggested keywords (Phase 10) ---------------- */
  .sug-keywords {
    margin-top: 16px;
    padding: 14px 14px 12px;
    background: var(--blue-soft);
    border: 1px solid rgba(0,113,227,0.18);
    border-radius: var(--r-md);
  }
  .sug-keywords .sug-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 10px; margin-bottom: 10px;
  }
  .sug-keywords .sug-eyebrow {
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--blue);
  }
  .sug-keywords .sug-hint {
    font-size: 11.5px; color: var(--text-3);
  }
  .sug-group { margin-top: 10px; }
  .sug-group:first-of-type { margin-top: 0; }
  .sug-label {
    font-size: 11.5px; font-weight: 600; color: var(--text-3);
    margin-bottom: 6px;
  }
  .sug-chips { display: flex; gap: 5px; flex-wrap: wrap; }
  .sug-chip-form { margin: 0; }
  .sug-chip {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 4px 10px 4px 8px; border-radius: var(--r-full);
    background: var(--surface); border: 1px solid var(--hairline);
    font-size: 12.5px; color: var(--text-2); font-family: inherit;
    cursor: pointer; transition: all 140ms ease;
  }
  .sug-chip:hover {
    border-color: var(--blue); color: var(--blue);
    background: white; transform: translateY(-1px);
  }
  .sug-chip .sug-plus {
    color: var(--blue); font-weight: 700; font-size: 14px;
    line-height: 1; margin-right: 1px;
  }

  .launch-block {
    margin-top: 32px; padding-top: 28px;
    border-top: 1px solid var(--hairline);
    display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap;
  }
  .launch-block .hint { color: var(--text-3); font-size: 13px; max-width: 360px; }

  /* ---------------- History list ---------------- */
  .runs ul { padding: 0; margin: 0; list-style: none; }
  .run-item {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 4px;
    border-top: 1px solid var(--hairline-2);
    font-size: 13.5px;
    transition: background 140ms ease, padding 140ms ease;
    border-radius: 8px;
  }
  .run-item:first-child { border-top: 0; }
  .run-item:hover { background: rgba(0,0,0,0.025); padding-left: 8px; padding-right: 8px; }
  .run-item .dot {
    width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; background: var(--text-4);
  }
  .run-item .dot.done { background: var(--green); }
  .run-item .dot.running { background: var(--amber); animation: pulse 1.4s ease-in-out infinite; }
  .run-item .dot.failed { background: var(--red); }
  .run-item .meta { flex: 1; min-width: 0; }
  .run-item .meta a {
    color: var(--text); font-weight: 500; display: block;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .run-item .meta a:hover { color: var(--blue); text-decoration: none; }
  .run-item .meta .sub { color: var(--text-3); font-size: 12px; margin-top: 1px; }
  .run-item .src-pills {
    display: flex; gap: 4px; flex-wrap: wrap; margin-top: 5px;
  }
  .run-item .src-pill {
    font-size: 10.5px; font-weight: 600; padding: 1px 7px;
    background: var(--blue-soft); color: var(--blue);
    border-radius: var(--r-full); text-transform: capitalize;
    letter-spacing: 0.01em;
  }
  .run-item .del {
    background: none; border: none; color: var(--text-4); cursor: pointer;
    width: 24px; height: 24px; border-radius: 50%; padding: 0;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 16px; line-height: 1;
    opacity: 0; transition: opacity 160ms ease, background 140ms ease;
  }
  .run-item:hover .del { opacity: 1; }
  .run-item .del:hover { background: var(--red-soft); color: var(--red); }

  .see-all {
    display: block; text-align: center; margin-top: 14px;
    padding: 10px; border-top: 1px solid var(--hairline-2);
    color: var(--blue); font-size: 13px; font-weight: 500;
  }
  .see-all:hover { background: rgba(0,113,227,0.04); border-radius: 0 0 var(--r-lg) var(--r-lg); text-decoration: none; }

  .icon-search-empty {
    width: 22px; height: 22px; stroke: currentColor; fill: none;
    stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
  }
{% endblock %}

{% block content %}
<!-- ============ Hero ============ -->
<section class="hero">
  <div class="hero-text fade-in">
    <div class="eyebrow"><span class="ping"></span> Phase 6 · Live</div>
    <h1>Détecte qui va recruter,<br><span class="grad">avant tout le monde.</span></h1>
    <p class="lead">Définis tes mots-clés, lance l'analyse, et reçois une liste classée d'entreprises à contacter — nominations de dirigeants, levées de fonds, signaux ESG &amp; IA.</p>
    <div class="hero-cta-row">
      <a href="#workspace" class="btn btn-primary btn-xl">Lancer une recherche</a>
      <a href="/results" class="btn btn-ghost btn-lg">Voir les signaux ({{ total_signals }})</a>
    </div>
    <div class="hero-stats">
      <div class="stat"><span class="n">{{ total_signals }}</span><span class="l">Signaux détectés</span></div>
      <div class="stat"><span class="n">{{ runs|length }}</span><span class="l">Recherches lancées</span></div>
      <div class="stat"><span class="n">{{ watchlist|length }}</span><span class="l">En watchlist</span></div>
    </div>
  </div>

  <div class="hero-preview fade-in" aria-hidden="true">
    <div class="glow"></div>
    <div class="preview-card">
      <div class="pv-head"><span class="pv-dot"></span> Aperçu d'une recherche</div>
      <div class="pv-row">
        <div class="pv-score hot">92</div>
        <div class="pv-meta">
          <div class="name">Carbone 4 <span class="new">Nouveau</span></div>
          <div class="sum">Levée de 50 M€ annoncée. Recrute Head of Sales Engineering — contact immédiat.</div>
        </div>
      </div>
      <div class="pv-row">
        <div class="pv-score investigate">74</div>
        <div class="pv-meta">
          <div class="name">Greenly</div>
          <div class="sum">Nomination d'un nouveau CTO. Profil tech ESG aligné, angle "scaling" possible.</div>
        </div>
      </div>
      <div class="pv-row">
        <div class="pv-score watch">58</div>
        <div class="pv-meta">
          <div class="name">Sweep</div>
          <div class="sum">Mention CSRD dans la presse. Watch list — pas d'action immédiate.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ How it works ============ -->
<section class="how">
  <div class="step s1 fade-in">
    <div class="ico"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h10M4 17h7"/></svg></div>
    <div class="num">Étape 01</div>
    <h3>Définis tes mots-clés</h3>
    <p>Domaines, postes ciblés, signaux à suivre. Aucun setup technique.</p>
  </div>
  <div class="step s2 fade-in">
    <div class="ico"><svg viewBox="0 0 24 24"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2 2M16.4 16.4l2 2M5.6 18.4l2-2M16.4 7.6l2-2"/></svg></div>
    <div class="num">Étape 02</div>
    <h3>L'IA scanne les sources</h3>
    <p>500-900 articles collectés sur RSS, GDELT, NewsAPI puis classés par l'IA.</p>
  </div>
  <div class="step s3 fade-in">
    <div class="ico"><svg viewBox="0 0 24 24"><path d="m5 12 5 5L20 7"/></svg></div>
    <div class="num">Étape 03</div>
    <h3>Contacte avant tout le monde</h3>
    <p>Liste classée par score, avec angle d'attaque et contact suggéré.</p>
  </div>
</section>

<!-- ============ Why / Description ============ -->
<section class="why fade-in">
  <div class="why-head">
    <div class="why-eyebrow">Pourquoi Signal Tracker ?</div>
    <h2>Le bon timing, c'est avant que le poste soit publié.</h2>
    <p>Une nomination, une levée, un changement d'organigramme — chaque semaine, des centaines d'entreprises ESG, climate tech et IA déclenchent un signal qui annonce un futur recrutement. Signal Tracker les détecte automatiquement, les classe par pertinence, et te dit qui contacter, avec quel angle.</p>
  </div>

  <div class="why-grid">
    <div class="why-item">
      <div class="ico"><svg viewBox="0 0 24 24"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg></div>
      <div>
        <h4>Détection précoce</h4>
        <p>Cible les signaux faibles (nominations, levées de fonds, ouvertures de bureau) qui précèdent les recrutements de 2 à 8 semaines.</p>
      </div>
    </div>

    <div class="why-item b">
      <div class="ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></div>
      <div>
        <h4>Tes mots-clés, ton scoring</h4>
        <p>Tu définis les domaines et les postes qui comptent. L'IA apprend de ton feedback "pertinent / pas pertinent" et affine le classement à chaque recherche.</p>
      </div>
    </div>

    <div class="why-item p">
      <div class="ico"><svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
      <div>
        <h4>Sources premium agrégées</h4>
        <p>500 à 900 articles analysés par recherche : Les Échos, Maddyness, GDELT, NewsAPI, Pappers, France Travail. Tout en français, dédupliqué.</p>
      </div>
    </div>

    <div class="why-item a">
      <div class="ico"><svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
      <div>
        <h4>Angle d'attaque inclus</h4>
        <p>Chaque signal vient avec un score (urgence, fit, pertinence), un résumé en français, l'angle suggéré et le contact recommandé pour ton premier message.</p>
      </div>
    </div>

    <div class="why-item">
      <div class="ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
      <div>
        <h4>5 à 15 min par recherche</h4>
        <p>Lance une analyse, va te chercher un café, reviens à une liste classée. Pas de tableau Excel, pas de tabs LinkedIn ouverts à 23h.</p>
      </div>
    </div>

    <div class="why-item b">
      <div class="ico"><svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
      <div>
        <h4>Historique &amp; watchlist</h4>
        <p>Chaque recherche est sauvegardée avec ses signaux. Mets une entreprise en watchlist pour la prioriser dans les analyses suivantes.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ Workspace ============ -->
<div id="workspace" class="grid">

  <!-- Left: keyword editor + launch -->
  <div class="card fade-in">
    <h2 class="section-label">Mots-clés de la recherche</h2>

    {% set cat_labels = {"field": "Domaines &amp; secteurs", "job_title": "Postes ciblés", "other": "Autres mots-clés"} %}
    {% set cat_hints = {"field": "climate tech, AI for sustainability…", "job_title": "Sales Engineer, Climate Data Scientist…", "other": "CSRD, AI Act, RAG…"} %}

    {% for cat in keyword_categories %}
    <div class="kw-group">
      <div class="kw-label">
        {{ cat_labels[cat]|safe }}
        <span class="hint">{{ keywords_by_cat[cat]|length }} mot{{ "s" if keywords_by_cat[cat]|length != 1 else "" }}</span>
      </div>
      {% if keywords_by_cat[cat] %}
      <div class="chips">
        {% for kw in keywords_by_cat[cat] %}
        <span class="chip">{{ kw.value }}
          <form method="post" action="/keywords/{{ kw.id }}/delete"><button type="submit" class="chip-x" aria-label="Supprimer {{ kw.value }}">×</button></form>
        </span>
        {% endfor %}
      </div>
      {% endif %}
      <form class="inline-add" method="post" action="/keywords">
        <input type="hidden" name="category" value="{{ cat }}">
        <input type="text" name="value" placeholder="{{ cat_hints[cat] }}" required maxlength="255" aria-label="Ajouter un mot-clé">
        <button type="submit" title="Ajouter">Ajouter</button>
      </form>
    </div>
    {% endfor %}

    <div class="launch-block">
      <form method="post" action="/search" id="launch-form" style="margin:0;">
        <button type="submit" class="btn btn-primary btn-xl" id="launch-btn"
                {% if task_status == "running" %}disabled{% endif %}>
          Lancer la recherche
        </button>
      </form>
      <span class="hint">
        {% if task_status == "running" %}Une analyse est déjà en cours…
        {% else %}~500-900 articles collectés, puis classés par IA. Compte 5-15 min.{% endif %}
      </span>
    </div>
  </div>

  <!-- Right: history + watchlist -->
  <div>
    <div class="card card-interactive runs fade-in" style="margin-bottom: 22px;">
      <h2 class="section-label">Recherches précédentes <span class="count">{{ runs|length }}</span></h2>
      {% if not runs %}
      <div class="empty" style="padding: 28px 8px;">
        <div class="empty-icon">
          <svg class="icon-search-empty" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        Aucune recherche encore.<br>Lance la première !
      </div>
      {% else %}
      <ul>
        {% for run in runs %}
        <li>
          <div class="run-item">
            <span class="dot {{ run.status }}"></span>
            <div class="meta">
              <a href="/results?run={{ run.id }}">{{ run.label }}</a>
              <div class="sub">
                <span class="mono">{{ run.created_at.strftime("%d/%m %H:%M") if run.created_at else "" }}</span>
                {% if run.metrics and run.metrics.classify %} · {{ run.metrics.classify.signals_created }} signaux{% endif %}
                {% if run.status == "running" %} · en cours{% elif run.status == "failed" %} · échec{% endif %}
              </div>
              {% if run.selected_sources and run.selected_sources.selected_domain_ids %}
              <div class="src-pills" title="{{ run.selected_sources.rationale or '' }}">
                {% for d in run.selected_sources.selected_domain_ids %}
                <span class="src-pill">{{ d|replace('_', ' ') }}</span>
                {% endfor %}
              </div>
              {% endif %}
            </div>
            <form method="post" action="/searches/{{ run.id }}/delete">
              <button class="del" type="submit" title="Supprimer" aria-label="Supprimer cette recherche">×</button>
            </form>
          </div>
        </li>
        {% endfor %}
      </ul>
      <a href="/results" class="see-all">Voir tous les signaux ({{ total_signals }}) →</a>
      {% endif %}
    </div>

    <div class="card card-interactive fade-in" style="margin-bottom: 22px;">
      <h2 class="section-label">Mon CV{% if cv %} <span class="count">{{ cv.char_count }} car.</span>{% endif %}</h2>
      {% if cv %}
        <div style="display:flex; align-items:center; gap:10px; padding:10px 14px; background:var(--green-soft); color:var(--green-deep); border-radius:var(--r-md); font-size:13px;">
          <svg style="width:16px;height:16px; stroke:currentColor; fill:none; stroke-width:2; stroke-linecap:round; stroke-linejoin:round;" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
          <div style="min-width:0; flex:1;"><strong style="font-weight:600;">{{ cv.filename or "(texte collé)" }}</strong>{% if cv.profile_json %}<br><span style="font-size:11.5px; opacity:0.85;">Profil compact prêt · économie de tokens</span>{% endif %}</div>
        </div>
        <form class="inline-add" method="post" action="/cv" enctype="multipart/form-data" style="margin-top:12px;">
          <input type="file" name="cv_file" accept=".pdf,.txt" required style="flex:1; padding:7px 6px; font-size:12.5px;">
          <button type="submit" title="Remplacer le CV">Remplacer</button>
        </form>
        <form method="post" action="/cv/delete" style="margin-top:8px;">
          <button type="submit" style="background:none; border:none; color:var(--text-4); font-size:12px; cursor:pointer; font-family:inherit; padding:4px 8px;" onclick="return confirm('Supprimer le CV stocké ?')">Supprimer le CV</button>
        </form>

        {% set sug_total = (suggested_keywords.field|length) + (suggested_keywords.job_title|length) + (suggested_keywords.other|length) %}
        {% if sug_total > 0 %}
        <div class="sug-keywords" id="suggested-keywords">
          <div class="sug-head">
            <span class="sug-eyebrow">Suggestions du CV</span>
            <span class="sug-hint">Un clic ajoute le mot-clé</span>
          </div>
          {% set cat_labels = {"field": "Domaines", "job_title": "Postes", "other": "Outils & méthodes"} %}
          {% for cat in keyword_categories %}
            {% if suggested_keywords[cat] %}
            <div class="sug-group">
              <div class="sug-label">{{ cat_labels[cat] }}</div>
              <div class="sug-chips">
                {% for v in suggested_keywords[cat] %}
                <form method="post" action="/keywords/suggested/accept" class="sug-chip-form">
                  <input type="hidden" name="category" value="{{ cat }}">
                  <input type="hidden" name="value" value="{{ v }}">
                  <button type="submit" class="sug-chip" title="Ajouter « {{ v }} » à tes mots-clés">
                    <span class="sug-plus" aria-hidden="true">+</span>{{ v }}
                  </button>
                </form>
                {% endfor %}
              </div>
            </div>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      {% else %}
        <p class="muted" style="font-size:13px; margin: 0 0 12px;">Stocker ton CV te permet de générer des préparations personnalisées en un clic.</p>
        <form method="post" action="/cv" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:10px;">
          <label style="display:flex; flex-direction:column; gap:6px; font-size:12.5px; color:var(--text-3);">
            <span>PDF ou TXT</span>
            <input type="file" name="cv_file" accept=".pdf,.txt" style="font-size:13px;">
          </label>
          <label style="display:flex; flex-direction:column; gap:6px; font-size:12.5px; color:var(--text-3);">
            <span>ou colle le texte</span>
            <textarea name="cv_text" rows="3" placeholder="Colle ton CV ici (utile si PDF scanné)…" style="font-family:inherit; font-size:13px; padding:8px 10px; border:1px solid var(--hairline); border-radius:var(--r-sm); resize:vertical; color:var(--text); outline:none;"></textarea>
          </label>
          <button type="submit" class="btn btn-primary" style="font-size:13.5px; padding:9px 18px;">Enregistrer mon CV</button>
        </form>
      {% endif %}
    </div>

    <div class="card card-interactive fade-in">
      <h2 class="section-label">Watchlist <span class="count">{{ watchlist|length }}</span></h2>
      {% if not watchlist %}
      <div class="muted" style="font-size:13px; margin-bottom:10px;">Aucune entreprise prioritaire pour l'instant.</div>
      {% else %}
      <div class="chips">
        {% for entry in watchlist %}
        <span class="chip">{{ entry.company_name }}
          <form method="post" action="/watchlist/{{ entry.id }}/delete"><button type="submit" class="chip-x" aria-label="Retirer {{ entry.company_name }}">×</button></form>
        </span>
        {% endfor %}
      </div>
      {% endif %}
      <form class="inline-add" method="post" action="/watchlist">
        <input type="text" name="company_name" placeholder="Nom d'entreprise" required maxlength="500" aria-label="Ajouter une entreprise à la watchlist">
        <button type="submit" title="Ajouter">Ajouter</button>
      </form>
    </div>
  </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
  // Start live polling as soon as the search is launched.
  var f = document.getElementById('launch-form');
  if (f) f.addEventListener('submit', function () {
    window.showLoader && window.showLoader(
      'Lancement de l\'analyse…',
      'Redirection vers les résultats — l\'analyse continue en arrière-plan.'
    );
    setTimeout(function () { if (window.__startStatusPolling) window.__startStatusPolling(); }, 500);
  });

  // CV upload triggers an LLM call to distill the profile (~5-10s).
  document.querySelectorAll('form[action="/cv"]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      var fileInput = form.querySelector('input[type="file"]');
      var textArea = form.querySelector('textarea[name="cv_text"]');
      var hasFile = fileInput && fileInput.files && fileInput.files.length > 0;
      var hasText = textArea && textArea.value.trim().length > 0;
      if (!hasFile && !hasText) return; // browser will show its required-field error
      window.showLoader && window.showLoader(
        'Analyse de ton CV…',
        'L\'IA extrait un profil compact réutilisable pour les préparations futures.'
      );
    });
  });
</script>
{% endblock %}
