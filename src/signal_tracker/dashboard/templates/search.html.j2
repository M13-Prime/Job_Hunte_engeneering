{% extends "base.html.j2" %}
{% block title %}Recherche — Signal Tracker{% endblock %}
{% block nav_search %}active{% endblock %}

{% block extra_css %}
  .overview { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 20px; align-items: start; margin-top: 20px; }
  @media (max-width: 1100px) { .overview { grid-template-columns: 1fr; } }
  .stack { display: flex; flex-direction: column; gap: 20px; min-width: 0; }

  .kw-intro { color: var(--ink-2); font-size: 14.5px; margin: -4px 0 18px; max-width: 640px; }
  .kw-group { padding: 14px 0; border-top: 1px solid var(--rule); }
  .kw-group:first-of-type { border-top: 0; padding-top: 0; }
  .kw-label { display: flex; align-items: baseline; gap: 10px; font-weight: 700; font-size: 14.5px; margin-bottom: 8px; }
  .kw-label .hint { color: var(--muted); font-weight: 400; font-size: 13px; }

  .sug-keywords { margin-top: 18px; padding: 16px 18px; background: var(--accent-50); border-radius: var(--r-md); border: 1px solid var(--accent-100); }
  .sug-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
  .sug-head h3 { font-size: 15px; }
  .sug-head .hint { color: var(--muted); font-size: 13px; }
  .sug-head form { margin: 0 0 0 auto; }
  .sug-group { margin-top: 10px; }
  .sug-label { font-size: 13px; font-weight: 700; color: var(--ink-2); margin-bottom: 6px; }
  .sug-chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .sug-chip-form { margin: 0; }
  .sug-chip {
    display: inline-flex; align-items: center; gap: 5px; height: 30px; padding: 0 12px 0 10px;
    border-radius: var(--r-full); background: var(--surface); border: 1px dashed var(--accent-strong);
    font: inherit; font-size: 13.5px; font-weight: 600; color: var(--ink); cursor: pointer;
  }
  .sug-chip:hover { background: var(--accent-100); border-style: solid; }
  .sug-chip .sug-plus { color: var(--accent-ink); font-weight: 700; }

  .launch-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--rule); }
  .launch-row .hint { color: var(--muted); font-size: 13.5px; max-width: 460px; }
  .launch-row form { margin: 0; }

  .runs ul { list-style: none; margin: 0; padding: 0; }
  .run-item { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-top: 1px solid var(--rule); }
  .runs li:first-child .run-item { border-top: 0; padding-top: 0; }
  .run-item .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; background: var(--faint); }
  .run-item .dot.done { background: var(--positive); }
  .run-item .dot.running { background: var(--accent); }
  .run-item .dot.failed { background: var(--negative); }
  .run-item .meta { flex: 1; min-width: 0; }
  .run-item .meta a { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .run-item .meta .sub { color: var(--muted); font-size: 13px; }
  .run-item .src-pills { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 5px; }
  .run-item .src-pill { font-size: 12px; font-weight: 600; padding: 1px 8px; background: var(--raised); color: var(--ink-2); border-radius: var(--r-full); }
  .run-item form { margin: 0; }
  .run-item .del { background: none; border: none; color: var(--muted); cursor: pointer; width: 28px; height: 28px; border-radius: 8px; font-size: 17px; line-height: 1; }
  .run-item .del:hover { background: var(--pill-negative-bg); color: var(--negative); }
  .see-all { display: inline-block; margin-top: 10px; font-size: 14px; }

  .cv-ok { display: flex; gap: 10px; align-items: center; padding: 10px 12px; background: var(--raised); border-radius: var(--r-md); font-size: 14px; }
  .cv-ok svg { width: 18px; height: 18px; stroke: var(--positive); fill: none; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  .cv-ok .name { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cv-ok .sub { color: var(--muted); font-size: 12.5px; }
  .file-row { display: flex; gap: 8px; align-items: center; margin-top: 12px; flex-wrap: wrap; }
  .file-row input[type=file] { flex: 1; min-width: 0; font-size: 13.5px; }
  .text-action { background: none; border: none; padding: 0; font: inherit; font-size: 13.5px; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .text-action:hover { color: var(--negative); }
  .cv-form { display: flex; flex-direction: column; gap: 10px; }
  .cv-form label { display: flex; flex-direction: column; gap: 6px; font-size: 13.5px; font-weight: 700; }
  .cv-form textarea { resize: vertical; min-height: 72px; }

  .nl-row { display: flex; align-items: center; gap: 12px; }
  .nl-row .txt { flex: 1; font-size: 14px; color: var(--ink-2); }
  .switch { position: relative; width: 40px; height: 24px; border-radius: 999px; border: none; cursor: pointer; background: var(--control); flex-shrink: 0; }
  .switch::after { content: ""; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: transform 140ms ease; }
  .switch[aria-checked="true"] { background: var(--ink); }
  .switch[aria-checked="true"]::after { transform: translateX(16px); }
{% endblock %}

{% block content %}
<div class="page-head">
  <div class="titles">
    <h1>Recherche</h1>
    <p class="sub">
      {% if week_signals %}{{ week_signals }} {{ "signaux" if week_signals != 1 else "signal" }} de recrutement cette semaine{% if strong_jobs %}, {{ strong_jobs }} offre{{ "s" if strong_jobs != 1 }} à 60 ou plus pour ton CV{% endif %}.
      {% elif runs %}Aucun nouveau signal cette semaine : élargis tes mots-clés ou ta watchlist.
      {% else %}Ajoute tes mots-clés et ton CV, puis lance ta première recherche.{% endif %}
    </p>
  </div>
  <div class="actions">
    {% if task_status == "running" %}
    <form method="post" action="/search/cancel" id="cancel-form" style="margin:0;">
      <button type="submit" class="btn btn-secondary" id="cancel-btn"
              onclick="this.disabled=true; this.innerText='Annulation…'; this.form.submit();">Annuler la recherche</button>
    </form>
    {% else %}
    <form method="post" action="/search" id="launch-form" style="margin:0;">
      <button type="submit" class="btn btn-primary" id="launch-btn">Lancer la recherche</button>
    </form>
    {% endif %}
  </div>
</div>

<form class="card country-card" method="post" action="/settings/country" style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:16px;">
  <label for="country-select" style="font-weight:700; font-size:13.5px;">Pays cible</label>
  <select id="country-select" name="country" onchange="this.form.submit()" style="min-width:180px;">
    {% for c in country_choices %}<option value="{{ c }}" {% if c == user_country %}selected{% endif %}>{{ c }}</option>{% endfor %}
  </select>
  <span class="muted" style="font-size:13px;">Les sources, la langue des articles et les résultats s'alignent sur ce pays.</span>
  <noscript><button type="submit" class="btn btn-sm btn-secondary">Enregistrer</button></noscript>
</form>

<div class="kpis" style="--kpi-n: 4;">
  <div class="kpi"><div class="label">Signaux détectés</div><div class="value"><a href="/results">{{ total_signals }}</a></div><div class="cap">dont {{ week_signals }} sur 7 jours</div></div>
  <div class="kpi"><div class="label">Offres à 60+</div><div class="value"><a href="/jobs?min_score=60">{{ strong_jobs }}</a></div><div class="cap">score IA contre ton CV</div></div>
  <div class="kpi"><div class="label">Candidatures en cours</div><div class="value"><a href="/applications">{{ active_apps }}</a></div><div class="cap">à postuler, postulées, entretiens</div></div>
  <div class="kpi"><div class="label">Relances dues</div><div class="value"><a href="/applications">{{ due_followups }}</a></div><div class="cap">{% if due_followups %}à faire aujourd'hui{% else %}rien en retard{% endif %}</div></div>
</div>

<div class="overview">
  <div class="stack">
    <section class="card" id="keywords">
      <h2 class="section-label">Mots-clés de la recherche</h2>
      <p class="kw-intro">Ils pilotent toute la recherche : les articles sont collectés à partir d'eux, ceux qui n'en mentionnent aucun sont écartés sans coût d'IA, et l'IA s'en sert pour classer les signaux.</p>

      {% set cat_labels = {"field": "Domaines et secteurs", "job_title": "Postes ciblés", "other": "Autres mots-clés"} %}
      {% set cat_hints = {"field": "climate tech, AI for sustainability…", "job_title": "Sales Engineer, Climate Data Scientist…", "other": "CSRD, AI Act, RAG…"} %}

      {% for cat in keyword_categories %}
      <div class="kw-group">
        <div class="kw-label">{{ cat_labels[cat] }} <span class="hint">{{ keywords_by_cat[cat]|length }} mot{{ "s" if keywords_by_cat[cat]|length != 1 else "" }}</span></div>
        {% if keywords_by_cat[cat] %}
        <div class="chips">
          {% for kw in keywords_by_cat[cat] %}
          <span class="chip">{{ kw.value }}
            <form method="post" action="/keywords/{{ kw.id }}/delete"><button type="submit" class="chip-x" aria-label="Supprimer {{ kw.value }}">×</button></form>
          </span>
          {% endfor %}
        </div>
        {% endif %}
        <form class="inline-add" method="post" action="/keywords">
          <input type="hidden" name="category" value="{{ cat }}">
          <input type="text" name="value" placeholder="{{ cat_hints[cat] }}" required maxlength="255" aria-label="Ajouter : {{ cat_labels[cat] }}">
          <button type="submit">Ajouter</button>
        </form>
      </div>
      {% endfor %}

      {% set sug_total = (suggested_keywords.field|length) + (suggested_keywords.job_title|length) + (suggested_keywords.other|length) %}
      {% if sug_total > 0 %}
      <div class="sug-keywords" id="suggested-keywords">
        <div class="sug-head">
          <h3>Suggestions du CV</h3>
          <span class="hint">Tirées de ton CV, un clic les ajoute.</span>
          <form method="post" action="/keywords/suggested/accept-all">
            <button type="submit" class="btn btn-sm btn-ghost">Tout ajouter ({{ sug_total }})</button>
          </form>
        </div>
        {% set sug_labels = {"field": "Domaines", "job_title": "Postes", "other": "Outils et méthodes"} %}
        {% for cat in keyword_categories %}
          {% if suggested_keywords[cat] %}
          <div class="sug-group">
            <div class="sug-label">{{ sug_labels[cat] }}</div>
            <div class="sug-chips">
              {% for v in suggested_keywords[cat] %}
              <form method="post" action="/keywords/suggested/accept" class="sug-chip-form">
                <input type="hidden" name="category" value="{{ cat }}">
                <input type="hidden" name="value" value="{{ v }}">
                <button type="submit" class="sug-chip" title="Ajouter « {{ v }} »"><span class="sug-plus" aria-hidden="true">+</span>{{ v }}</button>
              </form>
              {% endfor %}
            </div>
          </div>
          {% endif %}
        {% endfor %}
      </div>
      {% elif not cv %}
      <p class="muted" style="margin: 16px 0 0; font-size: 14px;">Ajoute ton CV à droite : des mots-clés te seront proposés à partir de ton parcours.</p>
      {% endif %}

      <div class="launch-row">
        <span class="hint">
          {% if task_status == "running" %}Une analyse est en cours ; l'annulation prend effet à l'étape suivante (5 à 20 s).
          {% else %}500 à 900 articles collectés puis classés par l'IA : compte 5 à 15 minutes.{% endif %}
        </span>
      </div>
    </section>

    <section class="card runs">
      <h2 class="section-label">Recherches précédentes <span class="count">{{ runs|length }}</span></h2>
      {% if not runs %}
      <p class="muted" style="margin:0;">Aucune recherche pour l'instant.</p>
      {% else %}
      <ul>
        {% for run in runs[:6] %}
        <li>
          <div class="run-item">
            <span class="dot {{ run.status }}"></span>
            <div class="meta">
              <a href="/results?run={{ run.id }}">{{ run.label }}</a>
              <div class="sub">
                <span class="num">{{ run.created_at.strftime("%d/%m %H:%M") if run.created_at else "" }}</span>
                {% if run.metrics and run.metrics.classify %} · {{ run.metrics.classify.signals_created }} signaux{% endif %}
                {% if run.metrics and run.metrics.classify and run.metrics.classify.keyword_filtered %} · {{ run.metrics.classify.keyword_filtered }} écartés sans IA{% endif %}
                {% if run.status == "running" %} · en cours{% elif run.status == "failed" %} · échec{% endif %}
              </div>
              {% if run.selected_sources and run.selected_sources.selected_domain_ids %}
              <div class="src-pills" title="{{ run.selected_sources.rationale or '' }}">
                {% for d in run.selected_sources.selected_domain_ids %}<span class="src-pill">{{ d|replace('_', ' ') }}</span>{% endfor %}
              </div>
              {% endif %}
            </div>
            <form method="post" action="/searches/{{ run.id }}/delete">
              <button class="del" type="submit" title="Supprimer" aria-label="Supprimer cette recherche">×</button>
            </form>
          </div>
        </li>
        {% endfor %}
      </ul>
      <a href="/results" class="see-all">Voir les {{ total_signals }} signaux</a>
      {% endif %}
    </section>
  </div>

  <aside class="stack">
    <section class="card">
      <h2 class="section-label">Mon CV{% if cv %} <span class="count">{{ cv.char_count }} car.</span>{% endif %}</h2>
      {% if cv %}
        <div class="cv-ok">
          <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
          <div style="min-width:0; flex:1;">
            <div class="name">{{ cv.filename or "Texte collé" }}</div>
            {% if cv.profile_json %}<div class="sub">Profil compact prêt : moins de tokens par appel</div>{% endif %}
          </div>
        </div>
        <form class="file-row" method="post" action="/cv" enctype="multipart/form-data">
          <input type="file" name="cv_file" accept=".pdf,.txt" required aria-label="Nouveau CV">
          <button type="submit" class="btn btn-sm btn-ghost">Remplacer</button>
        </form>
        <form method="post" action="/cv/delete" style="margin-top:10px;">
          <button type="submit" class="text-action" onclick="return confirm('Supprimer le CV enregistré ?')">Supprimer le CV</button>
        </form>
      {% else %}
        <p style="margin: 0 0 12px; font-size: 14px; color: var(--ink-2);">Ton CV sert au score de match des offres, aux CV adaptés et aux suggestions de mots-clés.</p>
        <form class="cv-form" method="post" action="/cv" enctype="multipart/form-data">
          <label>PDF ou TXT <input type="file" name="cv_file" accept=".pdf,.txt"></label>
          <label>ou colle le texte <textarea name="cv_text" rows="3" placeholder="Colle ton CV ici (utile si le PDF est scanné)"></textarea></label>
          <button type="submit" class="btn btn-primary">Enregistrer mon CV</button>
        </form>
      {% endif %}
    </section>

    <section class="card">
      <h2 class="section-label">Watchlist <span class="count">{{ watchlist|length }}</span></h2>
      {% if not watchlist %}
      <p class="muted" style="margin: 0 0 6px; font-size: 14px;">Les entreprises ajoutées ici passent en tête des signaux et leurs offres sont suivies chaque jour.</p>
      {% else %}
      <div class="chips">
        {% for entry in watchlist %}
        <span class="chip">{{ entry.company_name }}
          <form method="post" action="/watchlist/{{ entry.id }}/delete"><button type="submit" class="chip-x" aria-label="Retirer {{ entry.company_name }}">×</button></form>
        </span>
        {% endfor %}
      </div>
      {% endif %}
      <form class="inline-add" method="post" action="/watchlist">
        <input type="text" name="company_name" placeholder="Nom d'entreprise" required maxlength="500" aria-label="Ajouter une entreprise à la watchlist">
        <button type="submit">Ajouter</button>
      </form>
    </section>

    <section class="card">
      <h2 class="section-label">Newsletter hebdomadaire</h2>
      <div class="nl-row">
        <span class="txt">Chaque semaine : tes meilleures offres, les entreprises qui bougent et tes relances, avec les liens vers leurs sites.</span>
        <form method="post" action="/newsletter/toggle" style="margin:0;">
          <input type="hidden" name="next" value="/">
          <button type="submit" class="switch" role="switch" aria-checked="{{ 'true' if newsletter_opt_in else 'false' }}" aria-label="Recevoir la newsletter"></button>
        </form>
      </div>
      <a href="/newsletter/preview" target="_blank" rel="noopener" style="display:inline-block; margin-top:10px; font-size:14px;">Voir l'aperçu de cette semaine</a>
    </section>
  </aside>
</div>
{% endblock %}

{% block extra_js %}
<script>
  var f = document.getElementById('launch-form');
  if (f) f.addEventListener('submit', function () {
    window.showLoader && window.showLoader('Lancement de l\'analyse', 'L\'analyse continue en arrière-plan ; tu seras redirigé vers les signaux.');
    setTimeout(function () { if (window.__startStatusPolling) window.__startStatusPolling(); }, 500);
  });
  document.querySelectorAll('form[action="/cv"]').forEach(function (form) {
    form.addEventListener('submit', function () {
      var fileInput = form.querySelector('input[type="file"]');
      var textArea = form.querySelector('textarea[name="cv_text"]');
      var hasFile = fileInput && fileInput.files && fileInput.files.length > 0;
      var hasText = textArea && textArea.value.trim().length > 0;
      if (!hasFile && !hasText) return;
      window.showLoader && window.showLoader('Analyse de ton CV', 'L\'IA extrait un profil compact et des suggestions de mots-clés.');
    });
  });
</script>
{% endblock %}
