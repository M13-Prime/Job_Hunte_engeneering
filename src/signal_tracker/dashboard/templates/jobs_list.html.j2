{% extends "base.html.j2" %}
{% block title %}Offres — Signal Tracker{% endblock %}
{% block nav_jobs %}active{% endblock %}

{% block extra_css %}
  .jobs-head {
    display: flex; align-items: center; gap: 16px;
    margin-bottom: 8px; flex-wrap: wrap;
  }
  .jobs-head h1 {
    font-size: 32px; font-weight: 700; color: var(--text);
    letter-spacing: -0.028em; margin: 0;
  }
  .jobs-head .count-badge {
    background: rgba(0,0,0,0.06); color: var(--text-3);
    padding: 4px 12px; border-radius: var(--r-full);
    font-size: 13px; font-weight: 600;
  }
  .jobs-head .spacer { flex: 1; }
  .jobs-sub { color: var(--text-3); font-size: 14px; margin: 0 0 20px; max-width: 760px; }

  .flash {
    background: var(--blue-soft); color: var(--blue-strong);
    border-radius: var(--r-md); padding: 12px 16px; font-size: 14px; margin-bottom: 18px;
  }
  .flash.warn { background: var(--amber-soft); color: #8a4b00; }

  .filters { display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap; }
  .filters a {
    padding: 5px 12px; border-radius: var(--r-full); font-size: 13px;
    color: var(--text-3); background: rgba(0,0,0,0.04);
  }
  .filters a.active { background: var(--text); color: white; }
  .filters a:hover { text-decoration: none; }

  .jobs-card { padding: 0; overflow: hidden; }
  .job-row {
    display: grid;
    grid-template-columns: 58px minmax(0, 1.5fr) minmax(0, 1.3fr) auto;
    gap: 18px; align-items: center;
    padding: 16px 22px;
    border-bottom: 1px solid var(--hairline-2);
  }
  .job-row:last-child { border-bottom: 0; }
  .job-row:hover { background: rgba(0,0,0,0.018); }
  @media (max-width: 760px) {
    .job-row { grid-template-columns: 50px 1fr; gap: 10px 12px; padding: 14px 16px; }
    .job-row .angle { grid-column: 1 / -1; }
    .job-row .actions { grid-column: 1 / -1; justify-self: start; }
  }

  .score {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; padding: 7px 0; border-radius: var(--r-md);
    font-weight: 700; font-size: 14px; font-variant-numeric: tabular-nums;
  }
  .score.hot { background: var(--green-soft); color: var(--green-deep); }
  .score.investigate { background: var(--blue-soft); color: var(--blue); }
  .score.watch { background: var(--amber-soft); color: var(--amber); }
  .score.none { background: rgba(0,0,0,0.06); color: var(--text-3); }
  .score.kw { background: transparent; border: 1px dashed var(--hairline); color: var(--text-4); font-weight: 600; font-size: 12px; }

  .pos { min-width: 0; }
  .pos .title {
    font-weight: 600; font-size: 15.5px; color: var(--text);
    letter-spacing: -0.012em; line-height: 1.3;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;
  }
  .pos .title:hover { color: var(--blue); }
  .pos .sub {
    color: var(--text-3); font-size: 12.5px; margin-top: 3px;
    display: flex; gap: 6px; align-items: center; flex-wrap: wrap;
  }
  .pos .sub .sep { color: var(--text-4); }
  .pos .sub .ats {
    background: rgba(0,0,0,0.05); padding: 1px 8px;
    border-radius: var(--r-sm); font-weight: 500; text-transform: uppercase;
    font-size: 10.5px; letter-spacing: 0.04em;
  }
  .tracked {
    background: var(--purple-soft); color: var(--purple); padding: 1px 8px;
    border-radius: var(--r-full); font-weight: 600; font-size: 11px;
  }

  .angle {
    color: var(--text-2); font-size: 13px; line-height: 1.4;
    overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .angle .label {
    font-weight: 700; font-size: 10.5px; color: var(--text-3);
    text-transform: uppercase; letter-spacing: 0.05em; margin-right: 6px;
  }
  .actions { display: flex; gap: 6px; justify-self: end; }
  .actions form { margin: 0; }

  .empty-jobs {
    text-align: center; padding: 56px 24px; color: var(--text-3); font-size: 14.5px; line-height: 1.6;
  }
  .empty-jobs strong { color: var(--text); font-weight: 600; }
{% endblock %}

{% block content %}
<div class="jobs-head">
  <h1>Offres ouvertes</h1>
  <span class="count-badge mono">{{ rows|length }}</span>
  <span class="spacer"></span>
  <form method="post" action="/jobs/refresh"
        onsubmit="window.showLoader && window.showLoader('Actualisation lancée', 'Les offres arrivent en arrière-plan.');">
    <button type="submit" class="btn btn-primary btn-sm" {% if refresh.status == "running" %}disabled{% endif %}>
      {% if refresh.status == "running" %}Actualisation…{% else %}Actualiser les offres{% endif %}
    </button>
  </form>
</div>
<p class="jobs-sub">
  Offres publiées par les {{ companies_count }} entreprise(s) de ta watchlist et de tes signaux récents,
  scrapées directement sur leur page carrière. Le score IA compare chaque offre à ton CV.
</p>

{% if flash %}<div class="flash">{{ flash }}</div>{% endif %}
{% if not has_cv %}
<div class="flash warn">Pas de CV enregistré : ajoute-le depuis la page <a href="/">Recherche</a> pour activer le score IA et le CV adapté.</div>
{% endif %}
{% if refresh.status == "done" %}
<div class="flash">Dernière actualisation : {{ refresh.jobs_new }} nouvelle(s) offre(s) sur {{ refresh.companies_with_ats }}/{{ refresh.companies }} entreprise(s) trouvée(s), {{ refresh.jobs_scored }} scorée(s) par l'IA.</div>
{% elif refresh.status == "failed" %}
<div class="flash warn">L'actualisation a échoué : {{ refresh.error }}</div>
{% endif %}

<div class="filters">
  <a href="/jobs" class="{% if not min_score %}active{% endif %}">Toutes</a>
  <a href="/jobs?min_score=60" class="{% if min_score == 60 %}active{% endif %}">Match ≥ 60</a>
  <a href="/jobs?min_score=75" class="{% if min_score == 75 %}active{% endif %}">Match ≥ 75</a>
</div>

<div class="card jobs-card">
  {% if not rows %}
  <div class="empty-jobs">
    <strong>Aucune offre pour l'instant.</strong><br>
    Ajoute des entreprises à ta watchlist (page Recherche) ou lance une recherche de signaux,
    puis clique sur <em>Actualiser les offres</em>.
  </div>
  {% else %}
    {% for job, score_row in rows %}
    <div class="job-row" id="job-{{ job.id }}">
      {% if score_row %}
        {% set score = score_row.agent_score %}
        {% set tier = "hot" if score >= 75 else ("investigate" if score >= 60 else ("watch" if score >= 40 else "none")) %}
        <span class="score {{ tier }}" title="Score de match IA">{{ "%.0f"|format(score) }}</span>
      {% else %}
        <span class="score kw" title="Pas encore de score IA — score mots-clés">{{ "%.0f"|format(job.relevance_score) }}</span>
      {% endif %}
      <div class="pos">
        <a class="title" href="/jobs/{{ job.id }}">{{ job.title }}</a>
        <div class="sub">
          <span>{{ job.company_name }}</span>
          {% if job.location %}<span class="sep">·</span><span>{{ job.location }}</span>{% endif %}
          <span class="sep">·</span><span class="ats">{{ job.ats }}</span>
          {% if job.posted_at %}<span class="sep">·</span><span>{{ job.posted_at.strftime("%d/%m/%Y") }}</span>{% endif %}
          {% if job.id in tracked %}<span class="tracked">{{ status_labels[tracked[job.id]] }}</span>{% endif %}
        </div>
      </div>
      <div class="angle">
        {% if score_row and score_row.agent_killer_angle %}
          <span class="label">Angle</span>{{ score_row.agent_killer_angle }}
        {% elif score_row and score_row.agent_fit_reasoning %}
          {{ score_row.agent_fit_reasoning }}
        {% elif job.matched_roles %}
          <span class="label">Mots-clés</span>{{ job.matched_roles|join(", ") }}
        {% endif %}
      </div>
      <div class="actions">
        {% if not score_row %}
        <form method="post" action="/jobs/{{ job.id }}/score"
              onsubmit="window.showLoader && window.showLoader('Score IA en cours', 'Comparaison de l\'offre avec ton CV…');">
          <input type="hidden" name="next" value="/jobs{% if min_score %}?min_score={{ min_score }}{% endif %}#job-{{ job.id }}">
          <button type="submit" class="btn btn-ghost btn-sm" {% if not has_cv %}disabled title="Ajoute ton CV d'abord"{% endif %}>Scorer</button>
        </form>
        {% endif %}
        <a class="btn btn-link btn-sm" href="/jobs/{{ job.id }}">Détails</a>
      </div>
    </div>
    {% endfor %}
  {% endif %}
</div>
{% endblock %}
