{% extends "base.html.j2" %}
{% block title %}Offres — Signal Tracker{% endblock %}
{% block nav_jobs %}active{% endblock %}

{% block extra_css %}
  .jobs-head {
    display: flex; align-items: center; gap: 16px;
    margin-bottom: 24px; flex-wrap: wrap;
  }
  .jobs-head h1 {
    font-size: 32px; font-weight: 700; color: var(--text);
    letter-spacing: -0.028em; margin: 0;
  }
  .jobs-head .count-badge {
    background: rgba(0,0,0,0.06); color: var(--text-3);
    padding: 4px 12px; border-radius: var(--r-full);
    font-size: 13px; font-weight: 600;
  }

  .jobs-card { padding: 0; overflow: hidden; }
  .job-row {
    display: grid;
    grid-template-columns: 58px minmax(0, 1.6fr) minmax(0, 1.2fr) auto;
    gap: 18px; align-items: center;
    padding: 16px 22px;
    border-bottom: 1px solid var(--hairline-2);
    text-decoration: none; color: inherit;
    transition: background 140ms ease;
  }
  .job-row:last-child { border-bottom: 0; }
  .job-row:hover { background: rgba(0,0,0,0.018); text-decoration: none; }
  @media (max-width: 720px) {
    .job-row { grid-template-columns: 50px 1fr auto; gap: 12px; padding: 14px 16px; }
    .job-row .meta-right { display: none; }
  }

  .job-row .score {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; padding: 7px 0; border-radius: var(--r-md);
    font-weight: 700; font-size: 14px; font-variant-numeric: tabular-nums;
  }
  .job-row .score.hot { background: var(--red-soft); color: var(--red); }
  .job-row .score.investigate { background: var(--blue-soft); color: var(--blue); }
  .job-row .score.watch { background: var(--amber-soft); color: var(--amber); }
  .job-row .score.none { background: rgba(0,0,0,0.06); color: var(--text-3); }

  .job-row .pos { min-width: 0; }
  .job-row .pos .title {
    font-weight: 600; font-size: 15.5px; color: var(--text);
    letter-spacing: -0.012em; line-height: 1.3;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .job-row .pos .sub {
    color: var(--text-3); font-size: 12.5px; margin-top: 3px;
    display: flex; gap: 6px; align-items: center; flex-wrap: wrap;
  }
  .job-row .pos .sub .sep { color: var(--text-4); }
  .job-row .pos .sub .ats {
    background: rgba(0,0,0,0.05); padding: 1px 8px;
    border-radius: var(--r-sm); font-weight: 500; text-transform: uppercase;
    font-size: 10.5px; letter-spacing: 0.04em;
  }

  .job-row .angle {
    color: var(--text-2); font-size: 13px; line-height: 1.4;
    overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .job-row .angle .label {
    font-weight: 700; font-size: 10.5px; color: var(--text-3);
    text-transform: uppercase; letter-spacing: 0.05em; margin-right: 6px;
  }

  .job-row .meta-right {
    color: var(--text-3); font-size: 12.5px;
    display: flex; flex-direction: column; gap: 3px;
    justify-self: end; text-align: right; min-width: 0;
  }

  .empty-jobs {
    text-align: center; padding: 64px 24px; color: var(--text-3); font-size: 14.5px;
  }
  .empty-jobs strong { color: var(--text); font-weight: 600; }
{% endblock %}

{% block content %}
<div class="jobs-head">
  <h1>Offres ouvertes</h1>
  <span class="count-badge mono">{{ rows|length }}</span>
</div>

<div class="card jobs-card fade-in">
  {% if not rows %}
  <div class="empty-jobs">
    <strong>Aucune offre pour l'instant.</strong><br>
    Active <code>LLM_JOBS_AGENT_ENABLED</code> et relance une recherche.
  </div>
  {% else %}
    {% for job, score_row in rows %}
    {% set score = score_row.agent_score %}
    {% set tier = "hot" if score >= 75 else ("investigate" if score >= 50 else ("watch" if score >= 25 else "none")) %}
    <a class="job-row" href="{{ job.url }}" target="_blank" rel="noopener noreferrer">
      <span class="score {{ tier }}">{{ "%.0f"|format(score) }}</span>
      <div class="pos">
        <div class="title">{{ job.title }}</div>
        <div class="sub">
          <span>{{ job.company_name }}</span>
          {% if job.location %}<span class="sep">·</span><span>{{ job.location }}</span>{% endif %}
          <span class="sep">·</span><span class="ats">{{ job.ats }}</span>
          <span class="sep">·</span><span>agent ✓</span>
        </div>
      </div>
      <div class="angle">
        {% if score_row.agent_killer_angle %}
          <span class="label">Angle</span>{{ score_row.agent_killer_angle }}
        {% elif score_row.agent_fit_reasoning %}
          {{ score_row.agent_fit_reasoning }}
        {% elif job.matched_roles %}
          <span class="label">Match</span>{{ job.matched_roles|join(", ") }}
        {% endif %}
      </div>
      <div class="meta-right">
        {% if score_row.agent_why_now %}<span title="{{ score_row.agent_why_now }}">⚡ signal récent</span>{% endif %}
        {% if job.posted_at %}<span>{{ job.posted_at.strftime("%d/%m/%Y") }}</span>{% endif %}
      </div>
    </a>
    {% endfor %}
  {% endif %}
</div>
{% endblock %}
