<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>{% block title %}Signal Tracker{% endblock %}</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#f7f7f9">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Signal Tracker">
<meta name="format-detection" content="telephone=no">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'><rect width='180' height='180' rx='40' fill='%23fca61f'/><text x='90' y='126' font-family='Poppins,Arial,sans-serif' font-size='104' font-weight='700' text-anchor='middle' fill='%232b2645'>S</text></svg>">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%23fca61f'/><text x='32' y='45' font-family='Poppins,Arial,sans-serif' font-size='38' font-weight='700' text-anchor='middle' fill='%232b2645'>S</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&family=Poppins:wght@500;600&display=swap" rel="stylesheet">
<style>
  /* =====================================================================
     Design tokens — "accent ladder" app style (taste-skill), with the
     type and hues of the Saasto Figma kit: Poppins for titles and figures,
     Nunito Sans for text, one yellow hue (Fuel Yellow #FCA61F) at full
     strength on small marks only and as pale tints on areas, a deep
     violet-grey ink. No gradients, no glass, no shadows at rest.
     ===================================================================== */
  :root {
    --ground: #f7f7f9;
    --surface: #ffffff;
    --raised: #f3f3f6;
    --active: #ececf1;
    --border: #e6e6ec;
    --rule: #f0f0f4;
    --control: #d4d4dc;

    --ink: #2b2645;
    --ink-2: #3f3b57;
    --muted: #5c5870;
    --faint: #6b6b78;

    --accent: #fca61f;          /* full hue: small marks only */
    --accent-strong: #e8920a;
    --accent-50: #fffaf0;
    --accent-100: #fff4dc;       /* tint: areas */
    --accent-200: #ffe2a8;
    --accent-ink: #7a4600;       /* text on tints, 6:1 on --accent-100 */

    --positive: #247b50;  --pill-positive-bg: #dcfae5;  --pill-positive-ink: #04250e;
    --negative: #c4242a;  --pill-negative-bg: #ffedea;  --pill-negative-ink: #831c1e;

    --head: "Poppins", "Segoe UI", system-ui, sans-serif;
    --font: "Nunito Sans", "Segoe UI", system-ui, sans-serif;

    --fs-title: 26px; --fs-section: 16px; --fs-kpi: 28px; --fs-body: 15px; --fs-small: 13px;
    --gap: 16px; --card-pad: 22px;
    --sidebar: 236px;

    /* ---- Legacy names used by the page templates, mapped onto the ladder ---- */
    --bg: var(--ground);
    --surface-2: var(--raised);
    --hairline: var(--border);
    --hairline-2: var(--rule);
    --text: var(--ink);
    --text-2: var(--ink-2);
    --text-3: var(--muted);
    --text-4: var(--faint);
    --green: var(--accent);
    --green-strong: var(--accent-strong);
    --green-soft: var(--accent-100);
    --green-deep: var(--accent-ink);
    --blue: var(--ink);
    --blue-strong: #000000;
    --blue-soft: var(--raised);
    --blue-focus: var(--accent-strong);
    --amber: var(--accent-ink);
    --amber-soft: var(--accent-100);
    --red: var(--negative);
    --red-soft: var(--pill-negative-bg);
    --purple: var(--ink-2);
    --purple-soft: var(--active);
    --shadow-sm: none; --shadow-md: none; --shadow-lg: none;
    --shadow-xl: 0 18px 48px rgba(43,38,69,0.16), 0 2px 6px rgba(43,38,69,0.06);
    --r-sm: 8px; --r-md: 12px; --r-lg: 16px; --r-xl: 16px; --r-full: 999px;
    --display: var(--fs-title); --h1: var(--fs-title); --h2: 20px; --h3: 16px;
    --body: var(--fs-body); --small: 14px; --caption: 12px;
    --container: 1240px; --container-px: 32px; --nav-h: 52px;
  }

  * { box-sizing: border-box; }
  html, body { min-height: 100%; }
  body {
    margin: 0;
    font-family: var(--font);
    background: var(--ground);
    color: var(--ink);
    font-size: var(--fs-body);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  ::selection { background: var(--accent-200); color: var(--ink); }

  a { color: var(--ink); text-decoration: none; font-weight: 600; }
  a:hover { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px; }

  h1, h2, h3, h4 { font-family: var(--head); color: var(--ink); margin: 0; line-height: 1.2; }
  h1 { font-size: var(--fs-title); font-weight: 600; letter-spacing: -0.02em; }
  h2 { font-size: 18px; font-weight: 600; letter-spacing: -0.01em; }
  h3 { font-size: 16px; font-weight: 600; }
  h4 { font-size: 15px; font-weight: 600; }

  :focus { outline: none; }
  :focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 2px; border-radius: 6px; }

  .num, .mono { font-variant-numeric: tabular-nums; font-feature-settings: 'tnum'; }
  .muted { color: var(--muted); }
  .hidden { display: none !important; }
  .spacer { flex: 1; }

  /* ---------------- Shell: open plane, sidebar on the ground ---------------- */
  .shell { display: grid; grid-template-columns: var(--sidebar) minmax(0, 1fr); min-height: 100vh; }
  .sidebar {
    position: sticky; top: 0; height: 100vh; overflow-y: auto;
    padding: 22px 12px 18px; display: flex; flex-direction: column; gap: 4px;
    border-right: 1px solid var(--border);
  }
  .brand {
    display: flex; align-items: center; gap: 10px; padding: 0 10px 18px;
    font-family: var(--head); font-weight: 600; font-size: 17px; color: var(--ink);
    letter-spacing: -0.01em;
  }
  .brand:hover { text-decoration: none; }
  .brand .logo {
    width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0;
    background: var(--accent); color: var(--ink);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 15px; font-weight: 600;
  }
  .nav-group { display: flex; flex-direction: column; gap: 2px; margin-bottom: 14px; }
  .nav-group-label { font-size: 12.5px; color: var(--faint); padding: 6px 10px 4px; font-weight: 600; }
  .nav a {
    display: flex; align-items: center; gap: 10px; height: 34px; padding: 0 10px;
    border-radius: 10px; font-weight: 600; font-size: 14.5px; color: var(--ink-2);
  }
  .nav a svg { width: 17px; height: 17px; flex-shrink: 0; stroke: var(--faint); fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .nav a:hover { background: var(--raised); text-decoration: none; color: var(--ink); }
  .nav a.active { background: var(--accent-100); color: var(--accent-ink); }
  .nav a.active svg { stroke: var(--accent-strong); }
  .nav a .count { margin-left: auto; font-size: 12px; font-weight: 700; color: var(--accent-ink); }
  .sidebar-foot { margin-top: auto; display: flex; flex-direction: column; gap: 10px; padding: 0 4px; }

  .status-pill {
    display: inline-flex; align-items: center; gap: 8px; align-self: flex-start;
    padding: 5px 12px 5px 10px; border-radius: var(--r-full);
    font-size: 13px; font-weight: 600; color: var(--muted); background: var(--raised);
    white-space: nowrap;
  }
  .status-pill .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--faint); flex-shrink: 0; }
  .status-pill.running { background: var(--accent-100); color: var(--accent-ink); }
  .status-pill.running .dot { background: var(--accent); animation: pulse 1.4s ease-in-out infinite; }
  .status-pill.done { background: var(--pill-positive-bg); color: var(--pill-positive-ink); }
  .status-pill.done .dot { background: var(--positive); }
  .status-pill.failed { background: var(--pill-negative-bg); color: var(--pill-negative-ink); }
  .status-pill.failed .dot { background: var(--negative); }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

  .user-row {
    display: flex; align-items: center; gap: 10px; padding: 8px 6px;
    border-top: 1px solid var(--border); padding-top: 14px;
  }
  .user-row .avatar {
    width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
    background: var(--active); color: var(--ink); font-weight: 700; font-size: 13px;
    display: inline-flex; align-items: center; justify-content: center; text-transform: uppercase;
  }
  .user-row .email { flex: 1; min-width: 0; font-size: 13px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .user-row form { margin: 0; }
  .logout-btn {
    width: 30px; height: 30px; border-radius: 8px; border: none; background: transparent;
    color: var(--muted); cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
  }
  .logout-btn:hover { background: var(--pill-negative-bg); color: var(--negative); }
  .logout-btn svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .topbar { display: none; }
  main { min-width: 0; max-width: var(--container); width: 100%; padding: 34px var(--container-px) 72px; }

  /* Phone + tablet: the sidebar folds into a 52px top bar and a sheet. */
  @media (max-width: 960px) {
    .shell { display: block; }
    .topbar {
      display: flex; align-items: center; gap: 12px; position: sticky; top: 0; z-index: 40;
      height: var(--nav-h); padding: 0 16px; background: var(--ground); border-bottom: 1px solid var(--border);
    }
    .topbar .brand { padding: 0; font-size: 16px; }
    .topbar .menu-btn {
      margin-left: auto; height: 40px; padding: 0 14px; border-radius: var(--r-full);
      border: 1px solid var(--control); background: var(--surface); font: inherit; font-weight: 600; color: var(--ink);
    }
    .sidebar {
      display: none; position: fixed; inset: var(--nav-h) 0 0 0; height: auto; z-index: 39;
      background: var(--ground); border-right: 0; padding: 16px;
    }
    body.nav-open .sidebar { display: flex; }
    .sidebar > .brand { display: none; }
    .nav a { height: 44px; font-size: 16px; }
    main { padding: 22px 16px calc(48px + env(safe-area-inset-bottom)); }
  }
  @media (max-width: 640px) {
    input, select, textarea, button { font-size: 16px !important; }
  }

  /* ---------------- Page title row ---------------- */
  .page-head { display: flex; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 22px; }
  .page-head .titles { min-width: 0; flex: 1; }
  .page-head .sub { color: var(--muted); font-size: 15px; margin: 6px 0 0; max-width: 760px; }
  .page-head .actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  @media (max-width: 640px) { .page-head .actions { flex-basis: 100%; } .page-head .actions .btn, .page-head .actions form { width: 100%; } }

  /* ---------------- Buttons: flat, pill, one near-black primary ---------------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 38px; padding: 0 18px; border-radius: var(--r-full);
    font-family: var(--font); font-size: 14.5px; font-weight: 700; line-height: 1;
    cursor: pointer; white-space: nowrap; border: 1px solid transparent;
    transition: background 140ms ease, border-color 140ms ease, transform 120ms ease;
  }
  .btn:hover { text-decoration: none; }
  .btn:active { transform: scale(0.98); }
  .btn-primary { background: var(--ink); color: #fff; }
  .btn-primary:hover { background: #1b1730; color: #fff; }
  .btn-primary:disabled, .btn:disabled { background: var(--active); color: var(--faint); border-color: transparent; cursor: not-allowed; }
  .btn-accent { background: var(--accent); color: var(--ink); }
  .btn-accent:hover { background: var(--accent-strong); color: var(--ink); }
  .btn-ghost, .btn-secondary { background: var(--surface); color: var(--ink); border-color: var(--control); }
  .btn-ghost:hover, .btn-secondary:hover { background: var(--raised); color: var(--ink); }
  .btn-link { background: transparent; color: var(--ink); padding: 0 8px; height: 32px; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .btn-link:hover { text-decoration-thickness: 2px; }
  .btn-sm { height: 32px; padding: 0 14px; font-size: 13.5px; }
  .btn-lg { height: 44px; padding: 0 22px; font-size: 15.5px; }
  .btn-xl { height: 48px; padding: 0 26px; font-size: 16px; }

  /* ---------------- Surfaces ---------------- */
  .card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-lg); padding: var(--card-pad);
  }
  .card-sm { padding: 16px 18px; }
  .card h2.section-label, .section-label {
    font-family: var(--head); font-size: var(--fs-section); font-weight: 600; color: var(--ink);
    text-transform: none; letter-spacing: 0; margin: 0 0 14px;
    display: flex; align-items: center; gap: 8px;
  }
  .section-label .count {
    font-family: var(--font); background: var(--raised); color: var(--muted);
    border-radius: var(--r-full); padding: 1px 9px; font-size: 12.5px; font-weight: 700;
  }

  /* KPI strip: one container split by dividers, label over value. */
  .kpis { display: grid; grid-template-columns: repeat(var(--kpi-n, 4), minmax(0, 1fr)); background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); }
  .kpis .kpi { padding: 16px 20px; min-width: 0; }
  .kpis .kpi + .kpi { border-left: 1px solid var(--border); }
  .kpis .kpi .label { font-size: 13.5px; color: var(--muted); font-weight: 600; }
  .kpis .kpi .value { font-family: var(--head); font-size: var(--fs-kpi); font-weight: 600; color: var(--ink); line-height: 1.2; margin-top: 4px; font-variant-numeric: tabular-nums; }
  .kpis .kpi .value.lead { color: var(--ink); }
  .kpis .kpi .cap { font-size: 12.5px; color: var(--muted); margin-top: 2px; }
  .kpis .kpi a { color: inherit; }
  @media (max-width: 760px) {
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kpis .kpi + .kpi { border-left: 0; }
    .kpis .kpi:nth-child(even) { border-left: 1px solid var(--border); }
    .kpis .kpi:nth-child(n+3) { border-top: 1px solid var(--border); }
  }

  /* ---------------- Chips, inline add ---------------- */
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
  .chip {
    display: inline-flex; align-items: center; gap: 6px; flex: none; white-space: nowrap;
    background: var(--accent-100); color: var(--accent-ink);
    padding: 5px 8px 5px 12px; border-radius: var(--r-full);
    font-size: 13.5px; font-weight: 600;
  }
  .chip form { display: inline-flex; margin: 0; }
  .chip .chip-x {
    background: none; border: none; color: var(--accent-ink); cursor: pointer; padding: 0;
    font-size: 15px; line-height: 1; width: 18px; height: 18px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .chip .chip-x:hover { background: var(--accent-200); }
  .inline-add {
    display: flex; gap: 6px; margin-top: 8px; background: var(--surface);
    border: 1px solid var(--control); border-radius: var(--r-full); padding: 4px 4px 4px 14px;
  }
  .inline-add:focus-within { border-color: var(--ink); }
  .inline-add input, .inline-add input[type=text] { flex: 1; border: 0; border-radius: 0; height: auto; min-width: 0; padding: 6px 0; border: none; background: transparent; font: inherit; font-size: 14.5px; color: var(--ink); outline: none; }
  .inline-add input::placeholder { color: var(--faint); }
  .inline-add button {
    height: 32px; padding: 0 14px; background: var(--ink); color: #fff; border: none;
    border-radius: var(--r-full); font: inherit; font-size: 13.5px; font-weight: 700; cursor: pointer;
  }

  input[type=text], input[type=email], input[type=password], input[type=url], input[type=date], input[type=search], input[type=number], select, textarea {
    font-family: var(--font); font-size: 14.5px; color: var(--ink);
    border: 1px solid var(--control); border-radius: 10px; background: var(--surface); padding: 8px 12px;
  }
  input::placeholder, textarea::placeholder { color: var(--faint); }

  /* ---------------- Badges & score marks ---------------- */
  .badge {
    display: inline-flex; align-items: center; flex: none; white-space: nowrap;
    font-size: 12px; font-weight: 700; padding: 2px 9px; border-radius: var(--r-full);
    background: var(--raised); color: var(--muted);
  }
  .badge.hot { background: var(--accent-200); color: var(--accent-ink); }
  .badge.investigate { background: var(--accent-100); color: var(--accent-ink); }
  .badge.watch { background: var(--raised); color: var(--muted); }
  .badge.new { background: var(--ink); color: #fff; }
  .feedback-tag { font-size: 12px; font-weight: 700; padding: 2px 9px; border-radius: var(--r-full); }
  .feedback-tag.contacted { background: var(--accent-100); color: var(--accent-ink); }
  .feedback-tag.relevant { background: var(--pill-positive-bg); color: var(--pill-positive-ink); }
  .feedback-tag.not_relevant { background: var(--raised); color: var(--muted); }

  .empty { text-align: center; padding: 40px 20px; color: var(--muted); font-size: 15px; }
  .empty .empty-icon { display: none; }
  .flash { background: var(--accent-100); color: var(--accent-ink); border-radius: var(--r-md); padding: 12px 16px; font-size: 14.5px; font-weight: 600; margin-bottom: 18px; }
  .flash.warn { background: var(--pill-negative-bg); color: var(--pill-negative-ink); }

  /* ---------------- Toast & loader (things that float get a shadow) ---------------- */
  .toast {
    position: fixed; bottom: 24px; right: 24px; z-index: 100; max-width: 380px;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
    padding: 14px 18px; box-shadow: var(--shadow-xl); font-size: 14px;
    transform: translateY(120%); opacity: 0;
    transition: transform 280ms cubic-bezier(0.22,1,0.36,1), opacity 200ms ease;
  }
  .toast.visible { transform: translateY(0); opacity: 1; }
  .toast .toast-row { display: flex; gap: 12px; align-items: flex-start; }
  .toast .toast-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--positive); margin-top: 7px; flex-shrink: 0; }
  .toast.running .toast-dot { background: var(--accent); animation: pulse 1.4s ease-in-out infinite; }
  .toast.failed .toast-dot { background: var(--negative); }
  .toast .title { font-weight: 700; margin-bottom: 2px; color: var(--ink); }
  .toast .body { color: var(--muted); font-size: 13.5px; line-height: 1.45; }
  @media (max-width: 640px) { .toast { left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); max-width: none; } }

  .page-loader {
    position: fixed; inset: 0; z-index: 200; background: rgba(247,247,249,0.92);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity 200ms ease;
  }
  .page-loader.visible { opacity: 1; pointer-events: auto; }
  .loader-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
    padding: 28px 32px 24px; text-align: center; box-shadow: var(--shadow-xl);
    min-width: 300px; max-width: 380px; margin: 0 16px;
  }
  .loader-spin {
    width: 34px; height: 34px; margin: 0 auto 16px; border-radius: 50%;
    border: 3px solid var(--accent-100); border-top-color: var(--accent);
    animation: ldspin 0.9s linear infinite;
  }
  @keyframes ldspin { to { transform: rotate(360deg); } }
  .loader-title { font-family: var(--head); font-size: 16px; font-weight: 600; color: var(--ink); margin-bottom: 4px; }
  .loader-body { font-size: 14px; color: var(--muted); line-height: 1.5; }
  .loader-steps { display: none; }

  /* App screens have no entrance animations: content is visible at once. */
  .fade-in, .fade-in.is-visible { opacity: 1; transform: none; }
  .card-interactive:hover { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .loader-spin, .status-pill .dot, .toast .toast-dot { animation: none; }
  }

  /* ---------------- Public pages: sign in, sign up, pending ---------------- */
  main.public { max-width: 460px; margin: 0 auto; padding: 72px 16px 48px; }
  .auth-shell { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 34px 32px 28px; }
  .auth-shell .logo-row { display: flex; align-items: center; gap: 10px; font-family: var(--head); font-weight: 600; font-size: 17px; }
  .auth-shell .logo-row .logo { width: 28px; height: 28px; border-radius: 8px; background: var(--accent); color: var(--ink); display: inline-flex; align-items: center; justify-content: center; font-size: 15px; }
  .auth-shell h1 { margin: 22px 0 6px; }
  .auth-shell p.lead, .auth-shell p { color: var(--ink-2); font-size: 15px; margin: 0 0 20px; line-height: 1.55; }
  .auth-form { display: flex; flex-direction: column; gap: 14px; }
  .auth-form label { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 700; color: var(--ink); }
  .auth-form label .hint { font-weight: 400; color: var(--muted); font-size: 13px; }
  .auth-form input { height: 42px; }
  .auth-form input:focus { border-color: var(--ink); }
  .auth-form .err, .auth-shell .err { background: var(--pill-negative-bg); color: var(--pill-negative-ink); border-radius: var(--r-md); padding: 10px 14px; font-size: 14px; font-weight: 600; margin-bottom: 14px; }
  .auth-form button[type="submit"] { margin-top: 6px; height: 44px; border: none; border-radius: var(--r-full); background: var(--ink); color: #fff; font: inherit; font-size: 15px; font-weight: 700; cursor: pointer; }
  .auth-form button[type="submit"]:hover { background: #1b1730; }
  .auth-foot { margin-top: 20px; font-size: 14px; color: var(--muted); }
  .pending-shell .email { display: inline-block; margin: 0 0 16px; padding: 3px 12px; border-radius: var(--r-full); background: var(--raised); font-size: 14px; font-weight: 600; }
  .pending-shell .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .pending-shell .actions form { margin: 0; }
  .pending-shell .actions a, .pending-shell .actions button { height: 38px; display: inline-flex; align-items: center; padding: 0 16px; border-radius: var(--r-full); border: 1px solid var(--control); background: var(--surface); font: inherit; font-size: 14px; font-weight: 700; color: var(--ink); cursor: pointer; }

  {% block extra_css %}{% endblock %}
</style>
</head>
<body>

{% macro icon(name) -%}
<svg viewBox="0 0 24 24" aria-hidden="true">
{%- if name == "search" %}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
{%- elif name == "signals" %}<path d="M4 18V9M10 18V5M16 18v-6M22 18H2"/>
{%- elif name == "jobs" %}<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
{%- elif name == "apps" %}<rect x="3" y="4" width="5" height="16" rx="1.5"/><rect x="10" y="4" width="5" height="11" rx="1.5"/><rect x="17" y="4" width="4" height="7" rx="1.5"/>
{%- elif name == "preps" %}<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h7M9 17h5"/>
{%- elif name == "users" %}<circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M16 4.5a3.5 3.5 0 0 1 0 7M21 20c0-2.6-1.6-4.8-4-5.6"/>
{%- elif name == "mail" %}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
{%- elif name == "cost" %}<circle cx="12" cy="12" r="9"/><path d="M15 9.5c-.6-1-1.7-1.5-3-1.5-1.7 0-3 .9-3 2.2 0 3 6 1.6 6 4.6 0 1.3-1.3 2.2-3 2.2-1.4 0-2.6-.6-3.2-1.6M12 6v2M12 16v2"/>
{%- endif -%}
</svg>
{%- endmacro %}

{% if user and user.is_approved %}
<div class="shell">
  <header class="topbar">
    <a href="/" class="brand"><span class="logo">S</span> Signal Tracker</a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="sidebar" onclick="var o=document.body.classList.toggle('nav-open'); this.setAttribute('aria-expanded', o ? 'true' : 'false'); this.textContent = o ? 'Fermer' : 'Menu';">Menu</button>
  </header>

  <aside class="sidebar" id="sidebar">
    <a href="/" class="brand"><span class="logo">S</span> Signal Tracker</a>
    <nav class="nav" aria-label="Navigation principale">
      <div class="nav-group">
        <span class="nav-group-label">Veille marché</span>
        <a href="/" class="{% block nav_search %}{% endblock %}">{{ icon("search") }} Recherche</a>
        <a href="/results" class="{% block nav_results %}{% endblock %}">{{ icon("signals") }} Signaux</a>
      </div>
      <div class="nav-group">
        <span class="nav-group-label">Recherche d'emploi</span>
        <a href="/jobs" class="{% block nav_jobs %}{% endblock %}">{{ icon("jobs") }} Offres</a>
        <a href="/applications" class="{% block nav_applications %}{% endblock %}">{{ icon("apps") }} Candidatures</a>
        <a href="/preparations" class="{% block nav_preparations %}{% endblock %}">{{ icon("preps") }} Préparations</a>
      </div>
      {% if user.is_owner %}
      <div class="nav-group">
        <span class="nav-group-label">Administration</span>
        <a href="/admin/users" class="{% block nav_admin %}{% endblock %}">{{ icon("users") }} Utilisateurs</a>
        <a href="/admin/newsletter" class="{% block nav_newsletter %}{% endblock %}">{{ icon("mail") }} Newsletter</a>
        <a href="/admin/usage" class="{% block nav_usage %}{% endblock %}">{{ icon("cost") }} Coût IA</a>
      </div>
      {% endif %}
    </nav>
    <div class="sidebar-foot">
      <span id="status-pill" class="status-pill {{ task_status }}">
        <span class="dot"></span>
        <span id="status-text">
          {% if task_status == "running" %}Analyse en cours
          {% elif task_status == "done" %}Analyse terminée
          {% elif task_status == "failed" %}Échec de l'analyse
          {% else %}Prêt{% endif %}
        </span>
      </span>
      <div class="user-row">
        <span class="avatar">{{ user.email[:1] }}</span>
        <span class="email" title="{{ user.email }}">{{ user.email }}</span>
        <form method="post" action="/logout">
          <button type="submit" class="logout-btn" title="Se déconnecter" aria-label="Se déconnecter">
            <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          </button>
        </form>
      </div>
    </div>
  </aside>

  <main>
    {% block content %}{% endblock %}
  </main>
</div>
{% else %}
<main class="public">
  {% block public_content %}{{ self.content() }}{% endblock %}
</main>
{% endif %}

<div id="toast" class="toast">
  <div class="toast-row">
    <span class="toast-dot"></span>
    <div>
      <div class="title" id="toast-title">Analyse en cours</div>
      <div class="body" id="toast-body"></div>
    </div>
  </div>
</div>

<div id="page-loader" class="page-loader" aria-hidden="true">
  <div class="loader-card">
    <div class="loader-spin"></div>
    <div class="loader-title" id="loader-title">Chargement…</div>
    <div class="loader-body" id="loader-body">Quelques secondes…</div>
  </div>
</div>

<script>
(function () {
  const pill = document.getElementById('status-pill');
  const pillText = document.getElementById('status-text');
  const toast = document.getElementById('toast');
  const toastTitle = document.getElementById('toast-title');
  const toastBody = document.getElementById('toast-body');
  if (!pill) return;
  let polling = null;
  let lastStatus = (pill.className.match(/status-pill\s+(\w+)/) || [])[1] || 'idle';
  const stepLabels = { collect: 'Collecte des sources', classify: 'Analyse IA des signaux', jobs: 'Recherche des offres' };

  function showToast(cls) {
    toast.className = 'toast ' + cls + ' visible';
  }
  function hideToast() {
    toast.className = (toast.className || '').replace(/\bvisible\b/, '').trim();
  }
  function fmtMetrics(m) {
    if (!m) return '';
    const parts = [];
    if (m.collect) parts.push(`${m.collect.fetched} articles · ${m.collect.new} nouveaux`);
    if (m.classify) parts.push(`${m.classify.processed} traités · ${m.classify.signals_created} signaux`);
    return parts.join(' · ');
  }
  function apply(state) {
    const status = state.status || 'idle';
    pill.className = 'status-pill ' + status;
    if (status === 'running') {
      pillText.textContent = stepLabels[state.step] || 'Analyse en cours';
      showToast('running');
      toastTitle.textContent = stepLabels[state.step] || 'Analyse en cours';
      toastBody.innerHTML = fmtMetrics(state.metrics) || 'Démarrage…';
    } else if (status === 'done') {
      pillText.textContent = 'Analyse terminée';
      showToast('done');
      toastTitle.textContent = 'Analyse terminée';
      const rid = state.current_run_id;
      const link = rid ? `/results?run=${rid}` : '/results';
      // Build link safely (rid is numeric) — avoid innerHTML with mixed strings.
      const metricsText = fmtMetrics(state.metrics) || '';
      toastBody.textContent = metricsText ? metricsText + ' · ' : '';
      const a = document.createElement('a');
      a.href = link; a.textContent = 'Voir →';
      toastBody.appendChild(a);
      stop();
      // Only auto-navigate from the landing page. Anywhere else (a prep
      // report, preparations list, etc.) we just show the toast — yanking
      // the user mid-read is annoying.
      const onLanding = location.pathname === '/' || location.pathname === '';
      if (lastStatus === 'running' && onLanding) {
        setTimeout(() => { window.location.href = link; }, 1400);
      }
    } else if (status === 'failed') {
      pillText.textContent = 'Échec';
      showToast('failed');
      toastTitle.textContent = 'Analyse échouée';
      toastBody.textContent = state.error || 'Erreur inconnue';
      stop();
    }
    lastStatus = status;
  }
  // SSE (perf #4) replaces the 2s polling loop. Falls back to polling if
  // EventSource is unavailable (very old browsers) or if the SSE connection
  // errors out repeatedly.
  let evtSource = null;
  let fallbackInterval = null;
  function poll() { fetch('/run/status').then(r => r.json()).then(apply).catch(() => {}); }
  function startFallbackPolling() {
    if (fallbackInterval) return;
    fallbackInterval = setInterval(poll, 2500);
    poll();
  }
  function stopFallbackPolling() {
    if (fallbackInterval) { clearInterval(fallbackInterval); fallbackInterval = null; }
  }
  function startSSE() {
    if (typeof EventSource === 'undefined') { startFallbackPolling(); return; }
    if (evtSource) return;
    try {
      evtSource = new EventSource('/run/events');
    } catch (e) {
      startFallbackPolling();
      return;
    }
    let consecutiveErrors = 0;
    evtSource.onmessage = function (ev) {
      consecutiveErrors = 0;
      try { apply(JSON.parse(ev.data)); } catch (e) { /* ignore malformed */ }
    };
    evtSource.onerror = function () {
      consecutiveErrors += 1;
      // After 3 errors give up on SSE and fall back to polling — keeps the
      // banner alive even when Cloudflare / a corporate proxy strips SSE.
      if (consecutiveErrors >= 3) {
        if (evtSource) { evtSource.close(); evtSource = null; }
        startFallbackPolling();
      }
    };
  }
  function start() { startSSE(); }
  function stop() {
    if (evtSource) { evtSource.close(); evtSource = null; }
    stopFallbackPolling();
  }
  if (lastStatus === 'running') start();
  window.__startStatusPolling = start;
})();

// Fade-in entrance: stagger any .fade-in elements on load.
window.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.fade-in').forEach(function (el, i) {
    setTimeout(function () { el.classList.add('is-visible'); }, 60 + i * 90);
  });
});

// Reusable page loader. Call from form submit handlers when a request
// takes more than ~1s (LLM calls, CV upload, etc).
window.showLoader = function (title, body) {
  var ld = document.getElementById('page-loader');
  if (!ld) return;
  if (title) {
    var t = document.getElementById('loader-title');
    if (t) t.textContent = title;
  }
  if (body) {
    var b = document.getElementById('loader-body');
    if (b) b.textContent = body;
  }
  ld.classList.add('visible');
};
window.hideLoader = function () {
  var ld = document.getElementById('page-loader');
  if (ld) ld.classList.remove('visible');
};
// Auto-hide on back/forward navigation so a stuck loader doesn't persist.
window.addEventListener('pageshow', function (e) {
  if (e.persisted) window.hideLoader();
});
</script>
{% block extra_js %}{% endblock %}
</body>
</html>
