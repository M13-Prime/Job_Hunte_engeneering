{% extends "base.html.j2" %}
{% block title %}Connexion — Signal Tracker{% endblock %}

{% block content %}
<div class="auth-shell">
  <div class="logo-row"><span class="logo">S</span> Signal Tracker</div>
  <h1>Connexion</h1>
  <p class="lead">Connecte-toi pour accéder à tes recherches et préparations.</p>

  {% if error %}<div class="err">{{ error }}</div>{% endif %}

  <form class="auth-form" method="post" action="/login">
    <input type="hidden" name="next" value="{{ next or '/' }}">
    <label>Email
      <input type="email" name="email" required autocomplete="email" autofocus>
    </label>
    <label>Mot de passe
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button type="submit">Se connecter</button>
  </form>

  <div class="auth-foot">
    Pas encore de compte ? <a href="/signup">Créer un compte</a>
  </div>
</div>
{% endblock %}
