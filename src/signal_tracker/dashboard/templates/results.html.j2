{% extends "base.html.j2" %}
{% block title %}Signal Tracker — Résultats{% endblock %}
{% block nav_results %}active{% endblock %}

{% block extra_css %}
  .results-head {
    display: flex; align-items: center; gap: 16px;
    margin-bottom: 22px; flex-wrap: wrap;
  }
  .results-head h1 {
    
    letter-spacing: -0.028em; margin: 0;
  }
  .results-head .count-badge {
    background: rgba(0,0,0,0.06); color: var(--text-3);
    padding: 4px 12px; border-radius: var(--r-full);
    font-size: 13px; font-weight: 600;
  }
  .results-head .spacer { flex: 1; }
  .q-input { width: 220px; height: 34px; border-radius: 999px !important; padding: 0 14px !important; }
  @media (max-width: 640px) { .q-input { width: 100%; } }

  .filters {
    display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
    background: var(--surface); border: 1px solid var(--hairline);
    padding: 6px; border-radius: var(--r-full);
  }
  .filters .filter-label {
    font-size: 12.5px; font-weight: 600; color: var(--text-3); letter-spacing: 0; padding: 0 10px 0 12px;
  }
  .filters select, .filters input[type="number"] {
    padding: 7px 12px; border: none; background: transparent;
    font-size: 13.5px; font-family: inherit; color: var(--text);
    border-radius: var(--r-full); outline: none;
    transition: background 140ms ease;
  }
  .filters select:hover, .filters input[type="number"]:hover { background: rgba(0,0,0,0.04); }
  .filters input[type="number"] { width: 72px; text-align: center; font-variant-numeric: tabular-nums; }

  /* ---------------- Country filter ---------------- */
  .country-filter { margin-bottom: 18px; }
  .cf-details {
    background: var(--surface); border: 1px solid var(--hairline);
    border-radius: var(--r-md); overflow: hidden;
  }
  .cf-details > summary {
    list-style: none; cursor: pointer;
    padding: 10px 16px; display: flex; align-items: center; gap: 10px;
    font-size: 13.5px; color: var(--text-2);
  }
  .cf-details > summary::-webkit-details-marker { display: none; }
  .cf-details > summary:hover { background: rgba(0,0,0,0.02); }
  .cf-details[open] > summary { border-bottom: 1px solid var(--hairline-2); }
  .cf-icon svg { width: 16px; height: 16px; }
  .cf-chev { margin-left: auto; color: var(--text-4); transition: transform 160ms ease; }
  .cf-details[open] .cf-chev { transform: rotate(180deg); }
  .cf-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 12px; }
  .cf-scope { display: flex; gap: 18px; flex-wrap: wrap; }
  .cf-radio { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-2); cursor: pointer; }
  .cf-radio input { accent-color: var(--green); }
  .cf-radio em { color: var(--text-3); font-style: italic; }
  .cf-chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .cf-chip {
    display: inline-flex; align-items: center;
    padding: 5px 11px; border-radius: var(--r-full);
    background: var(--surface-2); border: 1px solid var(--hairline);
    font-size: 12.5px; color: var(--text-2); cursor: pointer;
    transition: all 140ms ease;
  }
  .cf-chip input { display: none; }
  .cf-chip:hover { border-color: var(--text-3); color: var(--text); }
  .cf-chip.selected { background: var(--green-soft); border-color: var(--green); color: var(--green-deep); font-weight: 600; }
  .cf-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 2px; }
  @media (max-width: 640px) {
    .cf-body { padding: 12px; }
    .cf-scope { gap: 12px; }
    .cf-chip { padding: 7px 12px; font-size: 13px; }
  }

  .run-banner {
    background: var(--green-soft); border: 1px solid rgba(52,199,89,0.25);
    color: var(--green-deep);
    border-radius: var(--r-md); padding: 12px 18px; margin-bottom: 22px; font-size: 14px;
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  }
  .run-banner strong { font-weight: 600; }
  .run-banner a { color: var(--green-deep); margin-left: auto; font-weight: 500; }

  /* Running banner — shown while the background pipeline is collecting/classifying */
  .running-banner {
    background: var(--blue-soft); border: 1px solid rgba(0,113,227,0.22);
    color: var(--blue); border-radius: var(--r-md);
    padding: 16px 20px; margin-bottom: 22px; font-size: 14.5px;
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  }
  .running-banner .spin {
    width: 22px; height: 22px; flex-shrink: 0;
    border: 2.5px solid rgba(0,113,227,0.2);
    border-top-color: var(--blue);
    border-radius: 50%;
    animation: rbspin 0.85s linear infinite;
  }
  @keyframes rbspin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .running-banner .spin { animation: none; } }
  .running-banner .copy { display: flex; flex-direction: column; gap: 2px; }
  .running-banner .title { font-weight: 600; color: var(--blue); }
  .running-banner .body { font-size: 13px; color: var(--text-3); }
  .running-banner .body strong { color: var(--text-2); font-weight: 600; }

  /* ---------------- Table ---------------- */
  .signals-card {
    padding: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  table.signals {
    width: 100%; min-width: 720px;
    border-collapse: collapse; font-size: 14px;
  }
  table.signals thead th {
    text-align: left; font-size: 12.5px; font-weight: 700; letter-spacing: 0;
    color: var(--text-3);
    padding: 14px 18px 12px;
    border-bottom: 1px solid var(--hairline);
    background: transparent; font-weight: 600;
  }
  table.signals tbody td {
    padding: 18px 18px;
    border-bottom: 1px solid var(--hairline-2);
    vertical-align: top;
    background: var(--surface);
    transition: background 140ms ease;
  }
  @media (max-width: 720px) {
    table.signals { min-width: 560px; font-size: 13px; }
    table.signals thead th { padding: 12px 12px 10px; }
    table.signals tbody td { padding: 14px 12px; }
    .col-source { width: 130px; }
  }

  /* ---------------- Mobile: table → stacked cards ---------------- */
  @media (max-width: 640px) {
    .signals-card { overflow-x: visible; }
    table.signals, table.signals tbody, table.signals tr { display: block; min-width: 0; }
    table.signals thead { display: none; }
    table.signals tbody td { display: block; padding: 0; border: 0; background: transparent; }
    table.signals tbody tr {
      display: block;
      padding: 16px 16px 14px;
      border-bottom: 1px solid var(--hairline-2);
      background: var(--surface);
    }
    table.signals tbody tr:last-child { border-bottom: 0; }
    table.signals tbody tr:hover td,
    table.signals tbody tr:hover { background: var(--surface); }
    .col-score { display: inline-block !important; margin-right: 10px; vertical-align: middle; }
    .col-source {
      width: auto; margin-top: 12px;
      padding-top: 10px !important; border-top: 1px solid var(--hairline-2) !important;
      font-size: 12.5px;
    }
    .col-actions {
      width: auto !important; padding-right: 0 !important;
      margin-top: 12px; padding-top: 12px;
      border-top: 1px solid var(--hairline-2);
    }
    .row-actions {
      opacity: 1; flex-direction: row; flex-wrap: wrap; gap: 6px;
    }
    .row-actions .mini { flex: 1 1 calc(50% - 3px); min-width: 0; }
    .row-actions .mini.prepare { flex-basis: 100%; padding: 11px 14px; }
    .summary { max-width: none; }
    .angle, .contact { max-width: none; }
    /* Filters row goes full width and wraps neatly. */
    .results-head { gap: 10px; }
    .results-head h1 { font-size: 26px; }
    .filters { width: 100%; flex-wrap: wrap; }
  }
  table.signals tbody tr:last-child td { border-bottom: 0; }
  table.signals tbody tr:hover td { background: rgba(0,0,0,0.018); }
  table.signals tbody tr.is-new td {
    background: var(--accent-50);
  }
  table.signals tbody tr.is-new:hover td { background: rgba(52,199,89,0.06); }

  .col-score { width: 78px; }
  .col-source { width: 170px; }
  .col-actions { width: 1%; white-space: nowrap; padding-right: 18px !important; }

  /* Score badge — Apple-tinted */
  .score-badge {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 50px; padding: 7px 10px; border-radius: var(--r-md);
    font-weight: 700; font-size: 14px; font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .score-badge { font-family: var(--head); font-weight: 600; }
  .score-badge.hot { background: var(--accent-200); color: var(--accent-ink); }
  .score-badge.investigate { background: var(--accent-100); color: var(--accent-ink); }
  .score-badge.watch { background: var(--raised); color: var(--muted); }

  /* Company cell */
  .company-cell .name-row {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    margin-bottom: 4px;
  }
  .company-cell .name {
    font-weight: 600; font-size: 15.5px; color: var(--text);
    letter-spacing: -0.012em; display: inline-flex; align-items: center; gap: 6px;
    transition: color 160ms ease;
  }
  .company-cell .name:hover { color: var(--blue); text-decoration: none; }
  .company-cell .name .external {
    width: 13px; height: 13px; stroke: currentColor; fill: none;
    stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round;
    opacity: 0; transition: opacity 160ms ease;
  }
  .company-cell .name:hover .external { opacity: 1; }

  .company-cell .type {
    color: var(--text-3); font-size: 12.5px; margin-bottom: 8px;
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  }
  .company-cell .type .sep { color: var(--text-4); }
  .company-cell .type .action-tag {
    background: rgba(0,0,0,0.05); color: var(--text-2);
    padding: 1px 8px; border-radius: var(--r-sm); font-weight: 500;
  }
  .company-cell .type .country-tag {
    background: var(--blue-soft); color: var(--blue);
    padding: 1px 8px; border-radius: var(--r-sm); font-weight: 500;
    display: inline-flex; align-items: center; gap: 4px;
  }
  .company-cell .type .country-tag .country-extra {
    background: rgba(0,113,227,0.15); color: var(--blue);
    padding: 0 5px; border-radius: var(--r-sm);
    font-size: 12.5px; font-weight: 700;
  }
  .summary {
    color: var(--text-2); margin: 0 0 8px; max-width: 580px; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
    overflow: hidden; overflow-wrap: anywhere;
  }
  .angle {
    background: var(--green-soft); border-radius: var(--r-sm);
    padding: 9px 14px; margin: 8px 0; font-size: 13px; max-width: 580px;
    color: var(--green-deep); border-left: 3px solid var(--green);
  }
  .angle strong { color: var(--green-deep); font-weight: 600; }
  .contact {
    font-size: 13px; color: var(--text-3); margin-top: 6px;
  }
  .contact strong { color: var(--text-2); font-weight: 600; }

  /* Source cell — clickable with favicon */
  .source-link {
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--text-2); font-size: 13px; padding: 4px 0;
    transition: color 160ms ease;
  }
  .source-link:hover { color: var(--blue); text-decoration: none; }
  .source-link .favicon {
    width: 16px; height: 16px; border-radius: 4px;
    background: var(--surface-2);
    flex-shrink: 0; object-fit: cover;
  }
  .source-link .external {
    width: 12px; height: 12px; stroke: currentColor; fill: none;
    stroke-width: 2.2; opacity: 0; transition: opacity 160ms ease;
  }
  .source-link:hover .external { opacity: 1; }

  /* Row actions — reveal on hover, Apple-quiet */
  .row-actions {
    display: flex; flex-direction: column; gap: 4px;
  }
  .row-actions form { margin: 0; }
  .mini {
    width: 100%; padding: 6px 14px;
    border: 1px solid var(--hairline);
    border-color: var(--control); border-radius: var(--r-full); background: var(--surface);
    font-size: 13px; font-weight: 700; color: var(--ink);
    font-family: inherit; cursor: pointer;
    transition: all 140ms ease; white-space: nowrap;
    min-width: 96px;
  }
  .mini:hover { border-color: var(--text-3); color: var(--text); }
  .mini.contacted:hover { border-color: var(--accent-strong); color: var(--accent-ink); background: var(--accent-100); }
  .mini.relevant:hover { border-color: var(--positive); color: var(--pill-positive-ink); background: var(--pill-positive-bg); }
  .mini.not_relevant:hover { border-color: var(--text-3); color: var(--text-3); background: rgba(0,0,0,0.04); }
  .mini.prepare {
    background: var(--text); color: white; border-color: var(--text);
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    text-decoration: none;
  }
  .mini.prepare:hover { background: #000; color: white; text-decoration: none; }

  /* Empty state */
  .empty-results {
    text-align: center; padding: 72px 24px;
  }
  .empty-results .empty-icon {
    width: 64px; height: 64px; margin: 0 auto 18px;
    border-radius: 50%; background: rgba(0,0,0,0.04);
    display: flex; align-items: center; justify-content: center;
    color: var(--text-4);
  }
  .empty-results h3 {
    font-size: 18px; font-weight: 600; color: var(--text); margin: 0 0 6px;
  }
  .empty-results p { color: var(--text-3); font-size: 14.5px; margin: 0 0 18px; }

  /* Lucide-ish inline icons */
  .ico { width: 16px; height: 16px; stroke: currentColor; fill: none;
         stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* ---------------- Company cards ---------------- */
  .company-list { display: grid; gap: 14px; padding: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr)); }
  .co-card {
    background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-md);
    padding: 18px; display: flex; flex-direction: column; gap: 12px;
  }
  .co-card.is-new { background: var(--accent-50); }
  .co-head { display: flex; gap: 12px; align-items: center; }
  .co-title { min-width: 0; }
  .co-name { font-weight: 600; font-size: 17px; color: var(--text); letter-spacing: -0.01em; }
  a.co-name:hover { color: var(--blue); text-decoration: none; }
  .co-name .external { width: 12px; height: 12px; margin-left: 5px; stroke: currentColor; fill: none; stroke-width: 2; opacity: .5; }
  .co-meta { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; font-size: 12.5px; color: var(--text-3); margin-top: 3px; }
  .co-type { background: var(--raised); border-radius: var(--r-full); padding: 1px 9px; font-size: 12px; color: var(--text-2); }
  .co-summary { margin: 0; font-size: 14px; line-height: 1.5; color: var(--text-2); }
  .co-people { border-top: 1px solid var(--hairline-2); padding-top: 10px; }
  .co-people h3 { margin: 0 0 6px; font-size: 12.5px; font-weight: 600; color: var(--text-3); }
  .co-people ul { margin: 0 0 6px; padding: 0; list-style: none; display: grid; gap: 3px; font-size: 13.5px; }
  .co-people .role { color: var(--text-3); }
  .co-people .muted { margin: 0 0 6px; font-size: 13px; color: var(--text-4); }
  .co-team-link { font-size: 12.5px; }
  .co-signals > summary { cursor: pointer; font-size: 13px; color: var(--text-3); list-style: none; }
  .co-signals > summary::-webkit-details-marker { display: none; }
  .co-signals > summary::before { content: "▸ "; }
  .co-signals[open] > summary::before { content: "▾ "; }
  .co-signals ul { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 12px; }
  .co-signals li { border-top: 1px solid var(--hairline-2); padding-top: 10px; }
  .co-signals li p { margin: 4px 0 6px; font-size: 13.5px; color: var(--text-2); }
  .sig-line, .sig-foot { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .sig-foot { justify-content: space-between; }
  .sig-score { font-weight: 600; font-variant-numeric: tabular-nums; font-size: 13px; }
  .sig-fb { display: flex; gap: 6px; }
  .sig-fb form { margin: 0; }
{% endblock %}

{% block content %}
<div class="results-head">
  <h1>Signaux</h1>
  <span class="count-badge mono" title="{{ rows|length }} signaux">{{ groups|length }} entreprise{{ "s" if groups|length > 1 }}</span>
  <div class="spacer"></div>
  <form class="filters" method="get" action="/results" id="results-filters">
    {% if run_id %}<input type="hidden" name="run" value="{{ run_id }}">{% endif %}
    {# Preserve country selections across filter changes #}
    {% for c in selected_countries %}<input type="hidden" name="country" value="{{ c }}">{% endfor %}
    <input type="hidden" name="country_scope" value="{{ country_scope }}">
    {% for k in selected_kw %}<input type="hidden" name="kw" value="{{ k }}">{% endfor %}
    {% if extra_terms %}<input type="hidden" name="extra" value="{{ extra_terms }}">{% endif %}
    {% if keyword_active %}<input type="hidden" name="kmode" value="{{ keyword_mode }}">{% endif %}
    <input type="search" name="q" value="{{ q }}" placeholder="Mot-clé, entreprise…" aria-label="Rechercher dans les signaux" class="q-input">
    <span class="filter-label">Feedback</span>
    <select name="feedback" onchange="this.form.submit()">
      <option value="" {% if filter_feedback == "" %}selected{% endif %}>Tous</option>
      <option value="pending" {% if filter_feedback == "pending" %}selected{% endif %}>Sans feedback</option>
      {% for f in valid_feedback %}
      <option value="{{ f }}" {% if filter_feedback == f %}selected{% endif %}>{{ f }}</option>
      {% endfor %}
    </select>
    <span class="filter-label">Score ≥</span>
    <input type="number" name="min_score" value="{{ min_score }}" min="0" max="100" step="5" onchange="this.form.submit()">
  </form>
</div>

<form class="country-filter" method="get" action="/results">
  {% if run_id %}<input type="hidden" name="run" value="{{ run_id }}">{% endif %}
  {% if filter_feedback %}<input type="hidden" name="feedback" value="{{ filter_feedback }}">{% endif %}
  {% if min_score %}<input type="hidden" name="min_score" value="{{ min_score }}">{% endif %}
  {% if q %}<input type="hidden" name="q" value="{{ q }}">{% endif %}
  {% for k in selected_kw %}<input type="hidden" name="kw" value="{{ k }}">{% endfor %}
  {% if extra_terms %}<input type="hidden" name="extra" value="{{ extra_terms }}">{% endif %}
  {% if keyword_active %}<input type="hidden" name="kmode" value="{{ keyword_mode }}">{% endif %}
  <details class="cf-details" {% if selected_countries %}open{% endif %}>
    <summary>
      <span class="cf-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </span>
      <span>Pays{% if selected_countries %} · <strong>{{ selected_countries|length }} sélectionné{{ 's' if selected_countries|length > 1 else '' }}</strong>{% endif %}</span>
      <span class="cf-chev" aria-hidden="true">▾</span>
    </summary>
    <div class="cf-body">
      <div class="cf-scope" role="radiogroup" aria-label="Portée du filtre pays">
        <label class="cf-radio">
          <input type="radio" name="country_scope" value="any" {% if country_scope == 'any' %}checked{% endif %}>
          <span>HQ <em>ou</em> activités dans le pays</span>
        </label>
        <label class="cf-radio">
          <input type="radio" name="country_scope" value="hq" {% if country_scope == 'hq' %}checked{% endif %}>
          <span>HQ uniquement</span>
        </label>
      </div>
      <div class="cf-chips">
        {% for c in available_countries %}
        <label class="cf-chip {{ 'selected' if c in selected_countries }}">
          <input type="checkbox" name="country" value="{{ c }}" {% if c in selected_countries %}checked{% endif %}>
          <span>{{ c }}</span>
        </label>
        {% endfor %}
      </div>
      <div class="cf-actions">
        <button type="submit" class="btn btn-sm btn-primary">Appliquer</button>
        {% if selected_countries or country_scope == 'hq' %}
        <a href="/results{% if run_id %}?run={{ run_id }}{% endif %}" class="btn btn-sm btn-ghost">Réinitialiser</a>
        {% endif %}
      </div>
    </div>
  </details>
</form>

<form class="country-filter" method="get" action="/results">
  {% if run_id %}<input type="hidden" name="run" value="{{ run_id }}">{% endif %}
  {% if filter_feedback %}<input type="hidden" name="feedback" value="{{ filter_feedback }}">{% endif %}
  {% if min_score %}<input type="hidden" name="min_score" value="{{ min_score }}">{% endif %}
  {% if q %}<input type="hidden" name="q" value="{{ q }}">{% endif %}
  {% for c in selected_countries %}<input type="hidden" name="country" value="{{ c }}">{% endfor %}
  <input type="hidden" name="country_scope" value="{{ country_scope }}">
  <details class="cf-details" {% if keyword_active %}open{% endif %}>
    <summary>
      <span class="cf-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </span>
      <span>Mots-clés{% if keyword_active %} · <strong>{{ (selected_kw|length) + (1 if extra_terms else 0) }} actif{{ 's' if (selected_kw|length) + (1 if extra_terms else 0) > 1 }} ({{ "ET" if keyword_mode == "all" else "OU" }})</strong>{% endif %}</span>
      <span class="cf-chev" aria-hidden="true">▾</span>
    </summary>
    <div class="cf-body">
      <div class="cf-scope" role="radiogroup" aria-label="Combinaison des mots-clés">
        <label class="cf-radio">
          <input type="radio" name="kmode" value="all" {% if keyword_mode == 'all' %}checked{% endif %}>
          <span>Tous les mots-clés (<em>ET</em>)</span>
        </label>
        <label class="cf-radio">
          <input type="radio" name="kmode" value="any" {% if keyword_mode == 'any' %}checked{% endif %}>
          <span>Au moins un (<em>OU</em>)</span>
        </label>
      </div>
      <div class="cf-chips">
        {% for k in keyword_choices %}
        <label class="cf-chip {{ 'selected' if k in selected_kw }}">
          <input type="checkbox" name="kw" value="{{ k }}" {% if k in selected_kw %}checked{% endif %}>
          <span>{{ k }}</span>
        </label>
        {% endfor %}
      </div>
      <input type="text" name="extra" value="{{ extra_terms }}" class="q-input" style="width:100%; margin-top:10px;"
             placeholder="Autres termes, séparés par des virgules (ex : sustainability, AI)">
      <div class="cf-actions">
        <button type="submit" class="btn btn-sm btn-primary">Appliquer</button>
        {% if keyword_active %}
        <a href="/results{% if run_id %}?run={{ run_id }}{% endif %}" class="btn btn-sm btn-ghost">Réinitialiser</a>
        {% endif %}
      </div>
      <p style="font-size:12.5px; color:var(--text-3); margin:8px 0 0;">Synonymes inclus : « AI » trouve aussi « intelligence artificielle », « sustainability » trouve « RSE », « ESG ».</p>
    </div>
  </details>
</form>

{% if task_status == "running" %}
<div class="running-banner" id="results-running-banner">
  <div class="spin" aria-hidden="true"></div>
  <div class="copy">
    <span class="title" id="rb-title">Analyse en cours</span>
    <span class="body" id="rb-body">L'IA collecte et trie les actualités. <strong>Compte 5 à 15 minutes.</strong> Cette page se rafraîchira automatiquement.</span>
  </div>
</div>
{% endif %}

{% if run_id and focus_run %}
<div class="run-banner">
  <strong>Recherche : {{ focus_run.label }}</strong>
  <span class="mono">· {{ focus_run.created_at.strftime("%d/%m %H:%M") if focus_run.created_at else "" }}</span>
  {% if focus_run.metrics and focus_run.metrics.classify %}
  <span>· {{ focus_run.metrics.classify.signals_created }} signaux trouvés</span>
  {% endif %}
  <a href="/results">Voir tous les signaux →</a>
</div>
{% endif %}

<div class="card signals-card">
  {% if not rows %}
  <div class="empty-results">
    <div class="empty-icon">
      <svg class="ico" style="width:28px;height:28px;" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
    </div>
    <h3>Aucun signal pour ces filtres</h3>
    <p>Ajuste tes filtres, ou lance une nouvelle recherche.</p>
    <a href="/" class="btn btn-primary">Lancer une recherche</a>
  </div>
  {% else %}
  <div class="company-list">
    {% for g in groups %}
    {% set site = company_urls.get(g.key) %}
    {% set top = g.top_signal %}
    <article class="co-card {{ 'is-new' if g.has_new }}">
      <header class="co-head">
        <span class="score-badge {{ g.tier }}" title="Meilleur score">{{ "%.0f"|format(g.best_score) }}</span>
        <div class="co-title">
          {% if site %}
          <a class="co-name" href="{{ site }}" target="_blank" rel="noopener noreferrer" title="Site de l'entreprise">{{ g.name }}<svg class="external" viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
          {% else %}
          <span class="co-name">{{ g.name }}</span>
          {% endif %}
          <div class="co-meta">
            {% if g.has_new %}<span class="badge new">Nouveau</span>{% endif %}
            <span>{{ g.count }} signal{{ 'x' if g.count > 1 }}</span>
            {% for t in g.types[:3] %}<span class="co-type">{{ t }}</span>{% endfor %}
            {% if g.hq_country %}<span class="country-tag" title="{% if g.countries %}Activités : {{ g.countries|join(', ') }}{% endif %}">{{ g.hq_country }}</span>{% endif %}
          </div>
        </div>
      </header>

      <p class="co-summary">{{ top.summary_fr }}</p>

      <section class="co-people" aria-label="Personnes clés">
        <h3>Personnes clés</h3>
        {% if g.people %}
        <ul>
          {% for p in g.people %}
          <li>
            <strong>{{ p.name }}</strong>{% if p.role %}<span class="role"> — {{ p.role }}</span>{% endif %}
            {% if p.is_new_hire %}<span class="badge new">Nouvelle recrue</span>{% endif %}
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="muted">Aucun nom cité dans les articles.</p>
        {% endif %}
        <a class="co-team-link" target="_blank" rel="noopener noreferrer"
           href="https://www.linkedin.com/search/results/people/?keywords={{ g.name|urlencode }}">Voir l'équipe sur LinkedIn ↗</a>
      </section>

      <details class="co-signals">
        <summary>{{ g.count }} article{{ 's' if g.count > 1 }} &amp; information{{ 's' if g.count > 1 }}</summary>
        <ul>
          {% for signal, raw in g.signals %}
          {% set domain = (raw.url.split('//')[-1].split('/')[0].replace('www.', '') if (raw and raw.url) else (raw.source if raw else "")) %}
          {% set my_fb = feedback_by_signal.get(signal.id) %}
          <li>
            <div class="sig-line">
              <span class="sig-score">{{ "%.0f"|format(signal.total_score) }}</span>
              <span class="co-type">{{ signal.signal_type }}</span>
              {% if my_fb %}<span class="feedback-tag {{ my_fb }}">{{ my_fb }}</span>{% endif %}
            </div>
            <p>{{ signal.summary_fr }}</p>
            <div class="sig-foot">
              {% if raw.url %}
              <a class="source-link" href="{{ raw.url }}" target="_blank" rel="noopener noreferrer" title="{{ raw.url }}">
                <img class="favicon" src="https://www.google.com/s2/favicons?domain={{ domain }}&amp;sz=32" alt="" loading="lazy" referrerpolicy="no-referrer">
                <span>{{ domain }}</span>
              </a>
              {% else %}
              <span class="source-link"><span>{{ raw.source }}</span></span>
              {% endif %}
              <span class="sig-fb">
                <form method="post" action="/signals/{{ signal.id }}/feedback">
                  <input type="hidden" name="action" value="relevant">
                  <input type="hidden" name="redirect_to" value="/results{% if run_id %}?run={{ run_id }}{% endif %}">
                  <button type="submit" class="mini relevant">Pertinent</button>
                </form>
                <form method="post" action="/signals/{{ signal.id }}/feedback">
                  <input type="hidden" name="action" value="not_relevant">
                  <input type="hidden" name="redirect_to" value="/results{% if run_id %}?run={{ run_id }}{% endif %}">
                  <button type="submit" class="mini not_relevant">Écarter</button>
                </form>
              </span>
            </div>
          </li>
          {% endfor %}
        </ul>
      </details>
    </article>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endblock %}

{% block extra_js %}
<script>
  // Live state for the running banner. Uses SSE (perf #4) with a polling
  // fallback. Reloads the page when the run flips to "done".
  (function () {
    var banner = document.getElementById('results-running-banner');
    if (!banner) return;
    var titleEl = document.getElementById('rb-title');
    var bodyEl = document.getElementById('rb-body');
    var stepLabels = { collect: 'Collecte des sources', classify: 'Analyse IA des signaux' };

    function apply (s) {
      if (!s) return;
      if (s.status === 'done') { window.location.reload(); return; }
      if (s.status === 'failed') {
        banner.style.background = 'var(--red-soft)';
        banner.style.borderColor = 'rgba(255,59,48,0.2)';
        if (titleEl) { titleEl.textContent = 'Analyse échouée'; titleEl.style.color = 'var(--red)'; }
        if (bodyEl) bodyEl.textContent = s.error || 'Erreur inconnue. Relance une recherche.';
        return;
      }
      if (s.status === 'running') {
        if (titleEl) titleEl.textContent = stepLabels[s.step] || 'Analyse en cours';
        if (bodyEl && s.metrics) {
          var parts = [];
          if (s.metrics.collect) {
            parts.push(s.metrics.collect.fetched + ' articles · ' + s.metrics.collect.new + ' nouveaux');
          }
          if (s.metrics.classify) {
            var c = s.metrics.classify;
            var seg = c.processed + ' traités · ' + c.signals_created + ' signaux';
            if (c.prefiltered_out) seg += ' · ' + c.prefiltered_out + ' filtrés';
            parts.push(seg);
          }
          if (parts.length) bodyEl.innerHTML = parts.join(' · ') + ' · <strong>continue à patienter</strong>';
        }
      }
    }

    var poller = null;
    function startPolling () {
      if (poller) return;
      var tick = function () {
        fetch('/run/status').then(function (r) { return r.json(); }).then(apply).catch(function () {});
      };
      tick();
      poller = setInterval(tick, 3000);
    }
    function tryStream () {
      if (typeof EventSource === 'undefined') { startPolling(); return; }
      var es;
      try { es = new EventSource('/run/events'); } catch (e) { startPolling(); return; }
      var errors = 0;
      es.onmessage = function (ev) {
        errors = 0;
        try { apply(JSON.parse(ev.data)); } catch (e) {}
      };
      es.onerror = function () {
        errors += 1;
        if (errors >= 3) { es.close(); startPolling(); }
      };
    }
    tryStream();
  })();
</script>
{% endblock %}
