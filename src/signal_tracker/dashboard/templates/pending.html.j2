{% extends "base.html.j2" %}
{% block title %}En attente de validation — Signal Tracker{% endblock %}

{% block content %}
<div class="auth-shell pending-shell">
  <h1>Compte en attente de validation</h1>
  {% if user %}
  <div class="email">{{ user.email }}</div>
  {% endif %}
  <p>Ton compte a bien été créé, mais un administrateur doit l'approuver avant que tu puisses utiliser l'outil.</p>
  <p>Reviens dans quelques heures, ou contacte l'admin si l'attente est trop longue.</p>
  <div class="actions">
    <a href="/login">Réessayer la connexion</a>
    {% if user %}
    <form method="post" action="/logout"><button type="submit">Se déconnecter</button></form>
    {% endif %}
  </div>
</div>
{% endblock %}
